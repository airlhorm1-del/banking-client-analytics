table dim_date_banking

	column date
		dataType: dateTime
		formatString: Short Date
		sourceColumn: date
		summarizeBy: none

	column year
		dataType: int64
		formatString: #,##0
		sourceColumn: year
		summarizeBy: none

	column quarter
		dataType: string
		sourceColumn: quarter
		summarizeBy: none

	column month_number
		dataType: int64
		formatString: #,##0
		sourceColumn: month_number
		summarizeBy: none

	column month_name
		dataType: string
		sourceColumn: month_name
		summarizeBy: none

	partition dim_date_banking = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents("C:\Users\user\OneDrive\Desktop\banking-client-analytics\clean\dim_date_banking.csv"),[Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.None]),
					#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"date", type date}, {"year", Int64.Type}, {"quarter", type text}, {"month_number", Int64.Type}, {"month_name", type text}})
				in
					#"Changed Type"
