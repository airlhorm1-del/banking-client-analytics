table banking_clients
	lineageTag: fc671e6d-95d1-4f00-9d26-b4a4dbab74ba

	measure 'Total Clients' = COUNTROWS(banking_clients)
		formatString: 0
		lineageTag: 0ef0345b-de23-418d-8efa-99c70284ab53

	measure 'Total Relationship Value' = SUM(banking_clients[total_relationship_value])
		lineageTag: 3e93ad5e-831c-4f65-b241-e7121ec97aa1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Relationship Value' = AVERAGE(banking_clients[total_relationship_value])
		lineageTag: df3accfa-8eeb-4c65-9be8-44dce946f4c2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Risk Weighting' = AVERAGE(banking_clients[risk_weighting])
		lineageTag: 3b1face0-6af4-4fae-a43b-cbab6c38ed64

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Estimated Income' = AVERAGE(banking_clients[estimated_income])
		lineageTag: cc7baea9-e7f0-4c4a-af22-fe54af77ee8b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Products Held' = AVERAGE(banking_clients[product_count])
		lineageTag: 894ad79c-c167-4f74-b1d6-306d69b642ee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Products per 100K Income' = AVERAGE(banking_clients[products_per_100k_income])
		lineageTag: 05e968d5-57e5-4d5c-a84f-d44c5922a706

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Share of Total Value' = DIVIDE([Total Relationship Value], CALCULATE([Total Relationship Value], ALL(banking_clients)))
		lineageTag: 1d3625e2-ae29-4b82-a318-205831c4fe4c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top 20% Share' = CALCULATE([Share of Total Value], banking_clients[value_quintile] = "Top 20%")
		formatString: 0.0%
		lineageTag: b62ce558-83a8-48d8-aeab-04965618b382

	measure 'High Risk Clients %' = DIVIDE(CALCULATE([Total Clients], banking_clients[risk_weighting] >= 4), [Total Clients])
		formatString: 0.0%
		lineageTag: 1501b934-9c88-4a39-8039-db80a4e4dcee

	measure 'High Risk Value' = CALCULATE([Total Relationship Value], banking_clients[risk_weighting] >= 4)
		formatString: #,##0.00
		lineageTag: 0b841079-0f49-496c-9aeb-49548ceb2139

	measure 'Clients With All 6 Products %' = DIVIDE(CALCULATE([Total Clients], banking_clients[product_count] = 6), [Total Clients])
		formatString: 0.0%
		lineageTag: 3fe3916f-01ad-4208-b57f-c4898de7292d

	measure 'Advisor Count' = DISTINCTCOUNT(banking_clients[investment_advisor])
		formatString: #,##0
		lineageTag: e7b2cf03-2cb4-49fd-8c19-b4f50b1895ea

	measure 'Quintile List HTML' =
			-- HTML for the HTML Content visual in the gold card: one white row per value quintile
			-- with a gold dot (filled for Top 20%), its label and its share of relationship value.
			-- Shares use the current selection (slicers still apply), so the 5 rows add up to 100%.
			VAR _total =
			    CALCULATE ( [Total Relationship Value], REMOVEFILTERS ( banking_clients[value_quintile] ) )
			VAR _quintiles =
			    DATATABLE (
			        "Quintile", STRING,
			        "Label", STRING,
			        "Order", INTEGER,
			        {
			            { "Top 20%", "Top 20%", 1 },
			            { "4th", "4th quintile", 2 },
			            { "3rd", "3rd quintile", 3 },
			            { "2nd", "2nd quintile", 4 },
			            { "Bottom 20%", "Bottom 20%", 5 }
			        }
			    )
			VAR _rows =
			    CONCATENATEX (
			        _quintiles,
			        VAR _q = [Quintile]
			        VAR _share =
			            DIVIDE (
			                CALCULATE ( [Total Relationship Value], banking_clients[value_quintile] = _q ),
			                _total
			            )
			        VAR _dotFill = IF ( [Order] = 1, "#A8894A", "#FFFFFF" )
			        VAR _gap = IF ( [Order] = 5, "0", "10px" )
			        RETURN
			            "<div style=""display:flex;align-items:center;box-sizing:border-box;height:28px;margin-bottom:" & _gap
			                & ";padding:0 14px;background:#FFFFFF;border-radius:13px;"">"
			                & "<span style=""display:inline-block;box-sizing:border-box;width:13px;height:13px;border-radius:50%;border:1.5px solid #A8894A;background:"
			                & _dotFill & ";""></span>"
			                & "<span style=""margin-left:12px;font-size:12px;font-weight:500;"">" & [Label] & "</span>"
			                & "<span style=""margin-left:auto;font-size:12px;font-weight:700;"">"
			                & FORMAT ( COALESCE ( _share, 0 ), "0.0%" ) & "</span>"
			                & "</div>",
			        "",
			        [Order], ASC
			    )
			RETURN
			    "<div style=""font-family:'Plus Jakarta Sans','Segoe UI',sans-serif;color:#17140F;"">" & _rows & "</div>"
		lineageTag: c8e3a8b6-3302-43ce-b0a6-42ade7f237a6

	measure 'Overview Subtitle HTML' =
			-- Page subtitle, e.g. 3,000 clients · 4 relationship types (follows the client-type slicer)
			VAR _n = [Total Clients]
			VAR _types = DISTINCTCOUNT ( banking_clients[banking_relationship] )
			RETURN
			    "<div style='font-family:Plus Jakarta Sans,Segoe UI,sans-serif;font-size:12.5px;line-height:16px;color:#5E5A52;white-space:nowrap;'>"
			        & FORMAT ( _n, "#,0" ) & " clients · " & _types
			        & IF ( _types = 1, " relationship type", " relationship types" ) & "</div>"
		lineageTag: 42e1e7f3-63ab-5317-8d88-e53ccdddd94b

	measure 'KPI Value HTML' =
			-- KPI card: total relationship value, share of the whole book, clients by year joined (6 bins)
			VAR _v = [Total Relationship Value]
			VAR _book = DIVIDE ( _v, CALCULATE ( [Total Relationship Value], ALL ( banking_clients ) ) )
			VAR _bins =
			    DATATABLE ( "Start", INTEGER, "End", INTEGER, "Order", INTEGER,
			        { { 1995, 1999, 1 }, { 2000, 2004, 2 }, { 2005, 2009, 3 }, { 2010, 2014, 4 }, { 2015, 2019, 5 }, { 2020, 2021, 6 } } )
			VAR _counts =
			    ADDCOLUMNS ( _bins, "@n",
			        VAR _s = [Start]
			        VAR _e = [End]
			        RETURN CALCULATE ( [Total Clients],
			            FILTER ( ALL ( banking_clients[joined_bank_date] ),
			                YEAR ( banking_clients[joined_bank_date] ) >= _s && YEAR ( banking_clients[joined_bank_date] ) <= _e ) ) )
			VAR _max = MAXX ( _counts, [@n] )
			VAR _bars =
			    CONCATENATEX ( _counts,
			        VAR _h = ROUND ( DIVIDE ( [@n], _max ) * 42, 1 )
			        RETURN "<rect x='" & FORMAT ( ( [Order] - 1 ) * 14, "0.0" ) & "' y='" & FORMAT ( 42 - _h, "0.0" )
			            & "' width='10.5' height='" & FORMAT ( _h, "0.0" ) & "' rx='2' fill='"
			            & IF ( [@n] = _max, "#C4A66A", "#E5D6AF" ) & "'/>",
			        "", [Order], ASC )
			RETURN
			    "<div style='position:relative;width:322px;height:111px;overflow:hidden;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:19px;top:24px;font-size:12.5px;line-height:16px;font-weight:500;color:#2F2B26;white-space:nowrap;'>Total relationship value</div><div style='position:absolute;left:70px;top:57px;font-size:27px;line-height:34px;font-weight:700;letter-spacing:-0.3px;white-space:nowrap;'>" & IF(_v >= 1000000000, FORMAT(_v / 1000000000, "0.00") & "bn", IF(_v >= 1000000, FORMAT(_v / 1000000, "0.00") & "M", IF(_v >= 1000, FORMAT(_v / 1000, "0") & "K", FORMAT(_v, "0")))) & "</div>"
			        & "<div style='position:absolute;left:176px;top:60px;font-size:11.5px;line-height:15px;font-weight:600;color:#3F6B4B;white-space:nowrap;'>" & FORMAT ( COALESCE ( _book, 0 ), "0%" ) & " of<br>book</div>"
			        & "<svg style='position:absolute;left:232px;top:23px;' width='81' height='42' viewBox='0 0 81 42'>" & _bars & "</svg>"
			        & "<div style='position:absolute;left:232px;top:68px;font-size:9px;line-height:13px;color:#6B665D;white-space:nowrap;'>Clients by year<br>joined, 1995–2021</div></div>"
		lineageTag: 8d850f3b-66d2-589f-9743-2bd3cb267123

	measure 'KPI Clients HTML' =
			-- KPI card: client count, share in the Jade tier, clients per loyalty tier
			VAR _n = [Total Clients]
			VAR _jade = DIVIDE ( CALCULATE ( [Total Clients], banking_clients[loyalty_classification] = "Jade" ), _n )
			VAR _tiers =
			    DATATABLE ( "Tier", STRING, "Order", INTEGER, { { "Jade", 1 }, { "Silver", 2 }, { "Gold", 3 }, { "Platinum", 4 } } )
			VAR _counts =
			    ADDCOLUMNS ( _tiers, "@n", VAR _t = [Tier] RETURN CALCULATE ( [Total Clients], banking_clients[loyalty_classification] = _t ) )
			VAR _max = MAXX ( _counts, [@n] )
			VAR _bars =
			    CONCATENATEX ( _counts,
			        VAR _h = ROUND ( DIVIDE ( [@n], _max ) * 42, 1 )
			        RETURN "<rect x='" & FORMAT ( ( [Order] - 1 ) * 18, "0" ) & "' y='" & FORMAT ( 42 - _h, "0.0" )
			            & "' width='12' height='" & FORMAT ( _h, "0.0" ) & "' rx='2' fill='"
			            & IF ( [@n] = _max, "#C4A66A", "#E5D6AF" ) & "'/>",
			        "", [Order], ASC )
			RETURN
			    "<div style='position:relative;width:322px;height:111px;overflow:hidden;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:19px;top:24px;font-size:12.5px;line-height:16px;font-weight:500;color:#2F2B26;white-space:nowrap;'>Clients</div><div style='position:absolute;left:70px;top:57px;font-size:27px;line-height:34px;font-weight:700;letter-spacing:-0.3px;white-space:nowrap;'>" & FORMAT ( _n, "#,0" ) & "</div>"
			        & "<div style='position:absolute;left:176px;top:60px;font-size:11.5px;line-height:15px;font-weight:600;color:#3F6B4B;white-space:nowrap;'>" & FORMAT ( COALESCE ( _jade, 0 ), "0%" ) & "<br>Jade</div>"
			        & "<svg style='position:absolute;left:226px;top:24px;' width='66' height='42' viewBox='0 0 66 42'>" & _bars & "</svg>"
			        & "<div style='position:absolute;left:214px;top:68px;font-size:9px;line-height:13px;color:#6B665D;white-space:nowrap;'>Jade · Silver · Gold ·<br>Plat.</div></div>"
		lineageTag: cf67d1b8-26c9-583c-813d-05124fb96ed0

	measure 'KPI Risk HTML' =
			-- KPI card: average risk weighting out of 5, clients at each risk level 1 to 5
			VAR _avg = [Avg Risk Weighting]
			VAR _levels = SELECTCOLUMNS ( GENERATESERIES ( 1, 5, 1 ), "Level", [Value] )
			VAR _counts = ADDCOLUMNS ( _levels, "@n", VAR _l = [Level] RETURN CALCULATE ( [Total Clients], banking_clients[risk_weighting] = _l ) )
			VAR _max = MAXX ( _counts, [@n] )
			VAR _dots =
			    CONCATENATEX ( _counts,
			        "<circle cx='" & FORMAT ( 4 + ( [Level] - 1 ) * 23, "0" ) & "' cy='"
			            & FORMAT ( 47.8 - DIVIDE ( [@n], _max ) * 36.8, "0.0" ) & "' r='3.4' fill='#C4A66A'/>",
			        "", [Level], ASC )
			RETURN
			    "<div style='position:relative;width:322px;height:111px;overflow:hidden;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:19px;top:24px;font-size:12.5px;line-height:16px;font-weight:500;color:#2F2B26;white-space:nowrap;'>Average risk weighting</div><div style='position:absolute;left:70px;top:57px;font-size:27px;line-height:34px;font-weight:700;letter-spacing:-0.3px;white-space:nowrap;'>" & FORMAT ( _avg, "0.00" ) & "</div>"
			        & "<div style='position:absolute;left:147px;top:67px;font-size:11px;line-height:15px;font-weight:500;color:#6B665D;white-space:nowrap;'>of 5</div>"
			        & "<svg style='position:absolute;left:198px;top:26px;' width='100' height='52' viewBox='0 0 100 52'>" & _dots & "</svg>"
			        & "<div style='position:absolute;left:200px;top:82px;font-size:9px;line-height:13px;color:#6B665D;white-space:nowrap;'>Clients at risk level 1 → 5</div></div>"
		lineageTag: 4a6f67c4-750b-5491-8017-6a2d3b03d638

	measure 'Client Profile HTML' =
			-- Client profile panel: averages per client and the top advisor by average client value
			VAR _segment = IF ( ISFILTERED ( banking_clients[banking_relationship] ), IF ( HASONEVALUE ( banking_clients[banking_relationship] ), VALUES ( banking_clients[banking_relationship] ) & " clients", "Selected clients" ), "All clients" )
			VAR _rv = [Avg Relationship Value]
			VAR _prod = [Avg Products Held]
			VAR _inc = [Avg Estimated Income]
			VAR _topRow = TOPN ( 1, VALUES ( banking_clients[investment_advisor] ), [Avg Relationship Value], DESC )
			VAR _name = MAXX ( _topRow, banking_clients[investment_advisor] )
			VAR _advN = CALCULATE ( [Total Clients], banking_clients[investment_advisor] = _name )
			VAR _advAvg = CALCULATE ( [Avg Relationship Value], banking_clients[investment_advisor] = _name )
			VAR _initials = LEFT ( _name, 1 ) & MID ( _name, FIND ( " ", _name, 1, 0 ) + 1, 1 )
			RETURN
			    "<div style='position:relative;width:322px;height:266px;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:20px;top:18px;font-size:16.5px;line-height:22px;font-weight:800;'>Client profile</div><div style='position:absolute;left:19px;top:41px;font-size:10.5px;line-height:14px;color:#6B665D;white-space:nowrap;'>" & _segment & " · averages per client</div>"
			        & "<div style='position:absolute;left:19px;top:102px;width:89px;font-size:16px;line-height:20px;font-weight:700;text-align:center;'>" & IF(_rv >= 1000000000, FORMAT(_rv / 1000000000, "0.00") & "bn", IF(_rv >= 1000000, FORMAT(_rv / 1000000, "0.00") & "M", IF(_rv >= 1000, FORMAT(_rv / 1000, "0") & "K", FORMAT(_rv, "0")))) & "</div>"
			        & "<div style='position:absolute;left:19px;top:129px;width:89px;font-size:9.5px;line-height:13px;color:#6B665D;text-align:center;'>relationship<br>value</div>"
			        & "<div style='position:absolute;left:117px;top:102px;width:88px;font-size:16px;line-height:20px;font-weight:700;text-align:center;'>" & FORMAT ( _prod, "0.0" ) & "</div>"
			        & "<div style='position:absolute;left:117px;top:129px;width:88px;font-size:9.5px;line-height:13px;color:#6B665D;text-align:center;'>products held</div>"
			        & "<div style='position:absolute;left:214px;top:102px;width:89px;font-size:16px;line-height:20px;font-weight:700;text-align:center;'>" & IF(_inc >= 1000000000, FORMAT(_inc / 1000000000, "0.00") & "bn", IF(_inc >= 1000000, FORMAT(_inc / 1000000, "0.00") & "M", IF(_inc >= 1000, FORMAT(_inc / 1000, "0") & "K", FORMAT(_inc, "0")))) & "</div>"
			        & "<div style='position:absolute;left:214px;top:129px;width:89px;font-size:9.5px;line-height:13px;color:#6B665D;text-align:center;'>estimated<br>income</div>"
			        & "<div style='position:absolute;left:19px;top:180px;font-size:11.5px;line-height:16px;font-weight:600;color:#2F2B26;white-space:nowrap;'>Top advisor by client value</div>"
			        & "<div style='position:absolute;left:19px;top:209px;width:40px;font-size:12px;line-height:40px;font-weight:700;color:#E8D6AE;text-align:center;'>" & _initials & "</div>"
			        & "<div style='position:absolute;left:70px;top:211px;font-size:13.5px;line-height:18px;font-weight:600;white-space:nowrap;'>" & _name & "</div>"
			        & "<div style='position:absolute;left:70px;top:231px;font-size:10.5px;line-height:14px;color:#6B665D;white-space:nowrap;'>"
			        & FORMAT ( _advN, "#,0" ) & " clients · avg " & IF(_advAvg >= 1000000000, FORMAT(_advAvg / 1000000000, "0.00") & "bn", IF(_advAvg >= 1000000, FORMAT(_advAvg / 1000000, "0.00") & "M", IF(_advAvg >= 1000, FORMAT(_advAvg / 1000, "0") & "K", FORMAT(_advAvg, "0")))) & " each</div></div>"
		lineageTag: dded3501-55b0-54e7-af44-ef02e451372f

	measure 'Wealth Headline HTML' =
			-- Top of the gold card: share of value held by the top 20% (within the current selection) and how many times the bottom 20%
			VAR _segment = IF ( ISFILTERED ( banking_clients[banking_relationship] ), IF ( HASONEVALUE ( banking_clients[banking_relationship] ), VALUES ( banking_clients[banking_relationship] ) & " clients", "Selected clients" ), "All clients" )
			VAR _all = CALCULATE ( [Total Relationship Value], REMOVEFILTERS ( banking_clients[value_quintile] ) )
			VAR _top = CALCULATE ( [Total Relationship Value], banking_clients[value_quintile] = "Top 20%" )
			VAR _bottom = CALCULATE ( [Total Relationship Value], banking_clients[value_quintile] = "Bottom 20%" )
			VAR _share = COALESCE ( DIVIDE ( _top, _all ), 0 )
			VAR _ratio = DIVIDE ( _top, _bottom )
			VAR _sentence =
			    IF ( ISFILTERED ( banking_clients[banking_relationship] ),
			        "of " & _segment & "' relationship value sits with clients in the bank-wide top 20%",
			        "of all relationship value sits with the top 20% of clients" )
			RETURN
			    "<div style='position:relative;width:322px;height:180px;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:19px;top:20px;font-size:10.5px;line-height:14px;font-weight:700;letter-spacing:1.6px;white-space:nowrap;'>WEALTH CONCENTRATION</div><div style='position:absolute;left:17px;top:41px;font-size:40px;line-height:46px;font-weight:800;letter-spacing:-0.4px;white-space:nowrap;'>"
			        & FORMAT ( _share, "0.0%" ) & "</div>"
			        & "<div style='position:absolute;left:19px;top:93px;width:280px;font-size:11.5px;line-height:15px;font-weight:500;color:#17140F;'>" & _sentence & "</div>"
			        & "<div style='position:absolute;left:19px;top:136px;width:282px;height:6px;border-radius:3px;background:rgba(255,255,255,0.38);overflow:hidden;'><div style='height:6px;border-radius:3px;background:#FFFFFF;width:" & FORMAT ( _share * 282, "0" ) & "px;'></div></div>"
			        & "<div style='position:absolute;left:19px;top:152px;width:282px;display:flex;justify-content:space-between;font-size:10.5px;line-height:14px;font-weight:600;'><span>Top 20%</span><span>"
			        & IF ( ISBLANK ( _ratio ), "", FORMAT ( _ratio, "0.0" ) & "× the bottom 20%" ) & "</span></div></div>"
		lineageTag: 44ef4cc7-99f9-58b7-8783-b447c0ecec6e

	measure 'Product Book HTML' =
			-- Product book panel: total balances per product, bar length relative to the largest product
			VAR _rows =
			    DATATABLE ( "Label", STRING, "Order", INTEGER,
			        { { "Deposits", 1 }, { "Business lending", 2 }, { "Loans", 3 }, { "Checking", 4 },
			           { "Savings", 5 }, { "Foreign currency", 6 }, { "Superannuation", 7 }, { "Credit cards", 8 } } )
			VAR _vals =
			    ADDCOLUMNS ( _rows, "@v",
			        SWITCH ( [Order],
			            1, SUM ( banking_clients[bank_deposits] ), 2, SUM ( banking_clients[business_lending] ),
			            3, SUM ( banking_clients[bank_loans] ), 4, SUM ( banking_clients[checking_accounts] ),
			            5, SUM ( banking_clients[saving_accounts] ), 6, SUM ( banking_clients[foreign_currency_account] ),
			            7, SUM ( banking_clients[superannuation_savings] ), 8, SUM ( banking_clients[credit_card_balance] ) ) )
			VAR _max = MAXX ( _vals, [@v] )
			VAR _list =
			    CONCATENATEX ( _vals,
			        VAR _top = 50 + ( [Order] - 1 ) * 25
			        VAR _v = [@v]
			        VAR _w = MAX ( 3, ROUND ( DIVIDE ( _v, _max ) * 102, 0 ) )
			        RETURN
			            "<div style='position:absolute;left:20px;top:" & _top & "px;font-size:11.5px;line-height:16px;color:#2F2B26;white-space:nowrap;'>" & [Label] & "</div>"
			            & "<div style='position:absolute;left:135px;top:" & ( _top + 3.5 ) & "px;width:102px;height:9px;border-radius:4.5px;background:#FFFFFF;overflow:hidden;'>"
			            & "<div style='height:9px;border-radius:4.5px;width:" & _w & "px;background:" & IF ( _v >= _max * 0.5, "#17140F", "#C4A66A" ) & ";'></div></div>"
			            & "<div style='position:absolute;right:21px;top:" & _top & "px;font-size:11.5px;line-height:16px;font-weight:700;white-space:nowrap;'>"
			            & IF(_v >= 1000000000, FORMAT(_v / 1000000000, "0.00") & "bn", IF(_v >= 1000000, FORMAT(_v / 1000000, "0.00") & "M", IF(_v >= 1000, FORMAT(_v / 1000, "0") & "K", FORMAT(_v, "0")))) & "</div>",
			        "", [Order], ASC )
			RETURN
			    "<div style='position:relative;width:322px;height:258px;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:20px;top:17px;font-size:16.5px;line-height:22px;font-weight:800;'>Product book</div><div style='position:absolute;right:21px;top:23px;font-size:10.5px;line-height:14px;color:#6B665D;'>Total balances</div>"
			        & _list & "</div>"
		lineageTag: 01dfeeab-2a2b-53eb-b9a2-ff11b0193500

	measure 'Risk Drivers HTML' =
			-- What drives risk panel: Pearson correlation of each client attribute with risk weighting,
			-- recalculated for the current selection, sorted strongest first, plus the key finding box.
			VAR _segment = IF ( ISFILTERED ( banking_clients[banking_relationship] ), IF ( HASONEVALUE ( banking_clients[banking_relationship] ), VALUES ( banking_clients[banking_relationship] ) & " clients", "Selected clients" ), "All clients" )
			VAR _ybar = AVERAGE ( banking_clients[risk_weighting] )
			VAR _syy = SUMX ( banking_clients, ( banking_clients[risk_weighting] - _ybar ) ^ 2 )
			VAR _drivers = DATATABLE ( "Key", STRING, "Label", STRING, { { "income", "Income" }, { "super", "Superannuation" }, { "loans", "Loans" }, { "business", "Business lending" }, { "fx", "Foreign currency" }, { "cards", "Credit card balance" }, { "checking", "Checking" }, { "property", "Properties owned" }, { "age", "Age" } } )
			VAR _withR =
			    ADDCOLUMNS ( _drivers, "@r",
			        VAR _k = [Key]
			        VAR _xbar = AVERAGEX ( banking_clients, SWITCH ( _k, "income", banking_clients[estimated_income], "super", banking_clients[superannuation_savings], "loans", banking_clients[bank_loans], "business", banking_clients[business_lending], "fx", banking_clients[foreign_currency_account], "cards", banking_clients[credit_card_balance], "checking", banking_clients[checking_accounts], "property", banking_clients[properties_owned], "age", banking_clients[age] ) )
			        VAR _sxy = SUMX ( banking_clients, ( SWITCH ( _k, "income", banking_clients[estimated_income], "super", banking_clients[superannuation_savings], "loans", banking_clients[bank_loans], "business", banking_clients[business_lending], "fx", banking_clients[foreign_currency_account], "cards", banking_clients[credit_card_balance], "checking", banking_clients[checking_accounts], "property", banking_clients[properties_owned], "age", banking_clients[age] ) - _xbar ) * ( banking_clients[risk_weighting] - _ybar ) )
			        VAR _sxx = SUMX ( banking_clients, ( SWITCH ( _k, "income", banking_clients[estimated_income], "super", banking_clients[superannuation_savings], "loans", banking_clients[bank_loans], "business", banking_clients[business_lending], "fx", banking_clients[foreign_currency_account], "cards", banking_clients[credit_card_balance], "checking", banking_clients[checking_accounts], "property", banking_clients[properties_owned], "age", banking_clients[age] ) - _xbar ) ^ 2 )
			        RETURN DIVIDE ( _sxy, SQRT ( _sxx * _syy ) ) )
			VAR _ranked = ADDCOLUMNS ( _withR, "@rank", RANKX ( _withR, [@r], , DESC, DENSE ) )
			VAR _fmt = "0.00"
			VAR _rows =
			    CONCATENATEX ( _ranked,
			        VAR _r = [@r]
			        VAR _top = 105 + ( [@rank] - 1 ) * 37.5
			        VAR _w = MIN ( 282, MAX ( 4, ROUND ( DIVIDE ( MAX ( _r, 0 ), 0.75 ) * 282, 0 ) ) )
			        VAR _txt = IF ( ABS ( _r ) < 0.005, "0.00", FORMAT ( _r, _fmt ) )
			        RETURN
			            "<div style='position:absolute;left:19px;top:" & _top & "px;font-size:11.5px;line-height:15px;color:#2F2B26;white-space:nowrap;'>" & [Label] & "</div>"
			            & "<div style='position:absolute;right:21px;top:" & _top & "px;font-size:11.5px;line-height:15px;font-weight:700;'>" & _txt & "</div>"
			            & "<div style='position:absolute;left:19px;top:" & ( _top + 17.5 ) & "px;width:282px;height:7px;border-radius:3.5px;background:#FFFFFF;overflow:hidden;'>"
			            & "<div style='height:7px;border-radius:3.5px;width:" & _w & "px;background:" & IF ( _r >= 0.45, "#17140F", "#C4A66A" ) & ";'></div></div>",
			        "", [@rank], ASC )
			VAR _rIncome = MAXX ( FILTER ( _withR, [Key] = "income" ), [@r] )
			VAR _rAge = MAXX ( FILTER ( _withR, [Key] = "age" ), [@r] )
			VAR _ageTxt = IF ( ABS ( _rAge ) < 0.005, "0.00", FORMAT ( _rAge, _fmt ) )
			RETURN
			    "<div style='position:relative;width:322px;height:658px;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:19px;top:18px;font-size:16.5px;line-height:22px;font-weight:800;'>What drives risk</div><div style='position:absolute;left:220px;top:22px;width:82px;font-size:10.5px;line-height:15px;font-weight:700;text-align:center;'>Correlation r</div><div style='position:absolute;left:19px;top:56px;width:275px;font-size:11.5px;line-height:17px;color:#4A463F;'>How strongly each client attribute moves with risk weighting.</div>"
			        & _rows
			        & "<div style='position:absolute;left:36px;top:549px;font-size:9.5px;line-height:13px;font-weight:700;letter-spacing:1.2px;color:#DCC994;white-space:nowrap;'>KEY FINDING</div><div style='position:absolute;left:36px;top:568px;width:252px;font-size:13.5px;line-height:19px;font-weight:600;color:#FFFFFF;'>Risk tracks wealth, not age or property count.</div><div style='position:absolute;left:36px;top:611px;font-size:10.5px;line-height:14px;color:#D9D4CB;white-space:nowrap;'>"
			        & "Income r = " & FORMAT ( _rIncome, _fmt ) & ", age r = " & _ageTxt & " for "
			        & IF ( _segment = "All clients", "all clients", _segment ) & ".</div></div>"
		lineageTag: 0239b64d-b98b-5267-8f05-fea0215e8ab8

	measure 'Wealth Subtitle HTML' =
			-- Wealth page subtitle (follows the client-type pills)
			"<div style='font-family:Plus Jakarta Sans,Segoe UI,sans-serif;font-size:12.5px;line-height:16px;color:#5E5A52;white-space:nowrap;'>"
			    & FORMAT ( [Total Clients], "#,0" ) & " clients · where value sits and how deep cross-sell goes</div>"
		lineageTag: f78d0a17-ff11-5528-89bc-e972d7e2b35c

	measure 'Wealth KPI Value HTML' =
			-- KPI card: average relationship value, the median, and the average per loyalty tier
			VAR _avg = [Avg Relationship Value]
			VAR _median = MEDIAN ( banking_clients[total_relationship_value] )
			VAR _vals = ADDCOLUMNS ( DATATABLE ( "Tier", STRING, "Order", INTEGER, { { "Jade", 1 }, { "Silver", 2 }, { "Gold", 3 }, { "Platinum", 4 } } ), "@n", VAR _t = [Tier] RETURN CALCULATE ( [Avg Relationship Value], banking_clients[loyalty_classification] = _t ) )
			VAR _max = MAXX ( _vals, [@n] )
			VAR _bars = CONCATENATEX ( _vals,
			        VAR _h = ROUND ( DIVIDE ( [@n], _max ) * 42, 1 )
			        RETURN "<rect x='" & FORMAT ( ( [Order] - 1 ) * 18, "0.0" ) & "' y='" & FORMAT ( 42 - _h, "0.0" )
			            & "' width='12' height='" & FORMAT ( _h, "0.0" ) & "' rx='2' fill='"
			            & IF ( [@n] = _max, "#C4A66A", "#E5D6AF" ) & "'/>",
			        "", [Order], ASC )
			RETURN
			    "<div style='position:relative;width:322px;height:111px;overflow:hidden;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:19px;top:24px;font-size:12.5px;line-height:16px;font-weight:500;color:#2F2B26;white-space:nowrap;'>Average relationship value</div><div style='position:absolute;left:70px;top:57px;font-size:27px;line-height:34px;font-weight:700;letter-spacing:-0.3px;white-space:nowrap;'>" & IF(_avg >= 1000000000, FORMAT(_avg / 1000000000, "0.00") & "bn", IF(_avg >= 1000000, FORMAT(_avg / 1000000, "0.00") & "M", IF(_avg >= 1000, FORMAT(_avg / 1000, "0") & "K", FORMAT(_avg, "0")))) & "</div>"
			        & "<div style='position:absolute;left:160px;top:60px;font-size:11px;line-height:15px;font-weight:600;color:#6B665D;white-space:nowrap;'>" & "median<br>" & IF(_median >= 1000000000, FORMAT(_median / 1000000000, "0.00") & "bn", IF(_median >= 1000000, FORMAT(_median / 1000000, "0.00") & "M", IF(_median >= 1000, FORMAT(_median / 1000, "0") & "K", FORMAT(_median, "0")))) & "</div>"
			        & "<svg style='position:absolute;left:236px;top:24px;' width='66' height='42' viewBox='0 0 66 42'>" & _bars & "</svg>"
			        & "<div style='position:absolute;left:236px;top:68px;font-size:9px;line-height:13px;color:#6B665D;white-space:nowrap;'>Avg value by tier,<br>Jade → Platinum</div></div>"
		lineageTag: a87a5d2e-86d9-5c0b-8ee6-ac0f379e1dcf

	measure 'Wealth KPI Top Share HTML' =
			-- KPI card: share of value held by the top 20%, how many times the bottom 20%, share per quintile
			VAR _all = CALCULATE ( [Total Relationship Value], REMOVEFILTERS ( banking_clients[value_quintile] ) )
			VAR _vals = ADDCOLUMNS ( DATATABLE ( "Quintile", STRING, "Label", STRING, "Order", INTEGER, { { "Top 20%", "Top 20%", 1 }, { "4th", "4th", 2 }, { "3rd", "3rd", 3 }, { "2nd", "2nd", 4 }, { "Bottom 20%", "Bottom 20%", 5 } } ), "@n", VAR _q = [Quintile] RETURN DIVIDE ( CALCULATE ( [Total Relationship Value], banking_clients[value_quintile] = _q ), _all ) )
			VAR _max = MAXX ( _vals, [@n] )
			VAR _top = MAXX ( FILTER ( _vals, [Order] = 1 ), [@n] )
			VAR _bottom = MAXX ( FILTER ( _vals, [Order] = 5 ), [@n] )
			VAR _bars = CONCATENATEX ( _vals,
			        VAR _h = ROUND ( DIVIDE ( [@n], _max ) * 42, 1 )
			        RETURN "<rect x='" & FORMAT ( ( [Order] - 1 ) * 15.5, "0.0" ) & "' y='" & FORMAT ( 42 - _h, "0.0" )
			            & "' width='11' height='" & FORMAT ( _h, "0.0" ) & "' rx='2' fill='"
			            & IF ( [@n] = _max, "#C4A66A", "#E5D6AF" ) & "'/>",
			        "", [Order], ASC )
			RETURN
			    "<div style='position:relative;width:322px;height:111px;overflow:hidden;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:19px;top:24px;font-size:12.5px;line-height:16px;font-weight:500;color:#2F2B26;white-space:nowrap;'>Top 20% share of value</div><div style='position:absolute;left:70px;top:57px;font-size:27px;line-height:34px;font-weight:700;letter-spacing:-0.3px;white-space:nowrap;'>" & FORMAT ( COALESCE ( _top, 0 ), "0.0%" ) & "</div>"
			        & "<div style='position:absolute;left:166px;top:60px;font-size:11px;line-height:15px;font-weight:600;color:#3F6B4B;white-space:nowrap;'>" & IF ( ISBLANK ( _bottom ), "", FORMAT ( DIVIDE ( _top, _bottom ), "0.0" ) & "×<br>bottom 20%" ) & "</div>"
			        & "<svg style='position:absolute;left:244px;top:24px;' width='73' height='42' viewBox='0 0 73 42'>" & _bars & "</svg>"
			        & "<div style='position:absolute;left:244px;top:68px;font-size:9px;line-height:13px;color:#6B665D;white-space:nowrap;'>Share by<br>quintile</div></div>"
		lineageTag: 04bc6451-9f2c-50a0-8c1d-2d27a578da41

	measure 'Wealth KPI Products HTML' =
			-- KPI card: average products held, share holding all 6, clients by number of products held
			VAR _avg = [Avg Products Held]
			VAR _all6 = [Clients With All 6 Products %]
			VAR _vals = ADDCOLUMNS ( SELECTCOLUMNS ( GENERATESERIES ( 1, 6, 1 ), "Order", [Value] ), "@n",
			    VAR _p = [Order] RETURN CALCULATE ( [Total Clients], banking_clients[product_count] = _p ) )
			VAR _max = MAXX ( _vals, [@n] )
			VAR _bars = CONCATENATEX ( _vals,
			        VAR _h = ROUND ( DIVIDE ( [@n], _max ) * 42, 1 )
			        RETURN "<rect x='" & FORMAT ( ( [Order] - 1 ) * 12.5, "0.0" ) & "' y='" & FORMAT ( 42 - _h, "0.0" )
			            & "' width='9' height='" & FORMAT ( _h, "0.0" ) & "' rx='2' fill='"
			            & IF ( [@n] = _max, "#C4A66A", "#E5D6AF" ) & "'/>",
			        "", [Order], ASC )
			RETURN
			    "<div style='position:relative;width:322px;height:111px;overflow:hidden;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:19px;top:24px;font-size:12.5px;line-height:16px;font-weight:500;color:#2F2B26;white-space:nowrap;'>Average products held</div><div style='position:absolute;left:70px;top:57px;font-size:27px;line-height:34px;font-weight:700;letter-spacing:-0.3px;white-space:nowrap;'>" & FORMAT ( _avg, "0.00" ) & "</div>"
			        & "<div style='position:absolute;left:166px;top:60px;font-size:11px;line-height:15px;font-weight:600;color:#3F6B4B;white-space:nowrap;'>" & FORMAT ( COALESCE ( _all6, 0 ), "0.0%" ) & "<br>hold all 6</div>"
			        & "<svg style='position:absolute;left:244px;top:24px;' width='72' height='42' viewBox='0 0 72 42'>" & _bars & "</svg>"
			        & "<div style='position:absolute;left:244px;top:68px;font-size:9px;line-height:13px;color:#6B665D;white-space:nowrap;'>Clients by<br>products, 1 → 6</div></div>"
		lineageTag: 79ba5b65-a6fa-5d32-ba6c-23f4fef73a6e

	measure 'Value By Quintile HTML' =
			-- Left top panel: share of relationship value per client quintile, as columns (top 20% in black)
			VAR _all = CALCULATE ( [Total Relationship Value], REMOVEFILTERS ( banking_clients[value_quintile] ) )
			VAR _vals = ADDCOLUMNS ( DATATABLE ( "Quintile", STRING, "Label", STRING, "Order", INTEGER, { { "Top 20%", "Top 20%", 1 }, { "4th", "4th", 2 }, { "3rd", "3rd", 3 }, { "2nd", "2nd", 4 }, { "Bottom 20%", "Bottom 20%", 5 } } ), "@n", VAR _q = [Quintile] RETURN DIVIDE ( CALCULATE ( [Total Relationship Value], banking_clients[value_quintile] = _q ), _all ) )
			VAR _max = MAXX ( _vals, [@n] )
			VAR _top = MAXX ( FILTER ( _vals, [Order] = 1 ), [@n] )
			VAR _bottom = MAXX ( FILTER ( _vals, [Order] = 5 ), [@n] )
			VAR _cols =
			    CONCATENATEX ( _vals,
			        VAR _x = 4 + ( [Order] - 1 ) * 94
			        VAR _h = ROUND ( DIVIDE ( [@n], _max ) * 160, 1 )
			        RETURN
			            "<rect x='" & _x & "' y='" & FORMAT ( 196 - _h, "0.0" ) & "' width='56' height='" & FORMAT ( _h, "0.0" )
			                & "' rx='7' fill='" & IF ( [Order] = 1, "#17140F", "#C4A66A" ) & "'/>"
			            & "<text x='" & ( _x + 28 ) & "' y='" & FORMAT ( 196 - _h - 9, "0.0" ) & "' text-anchor='middle' font-family='Plus Jakarta Sans, Segoe UI, sans-serif' font-size='12.5' font-weight='700' fill='#17140F'>"
			                & FORMAT ( COALESCE ( [@n], 0 ), "0.0%" ) & "</text>"
			            & "<text x='" & ( _x + 28 ) & "' y='218' text-anchor='middle' font-family='Plus Jakarta Sans, Segoe UI, sans-serif' font-size='11' fill='#2F2B26'>" & [Label] & "</text>",
			        "", [Order], ASC )
			RETURN
			    "<div style='position:relative;width:490px;height:350px;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:20px;top:18px;font-size:16.5px;line-height:22px;font-weight:800;'>Where the value sits</div><div style='position:absolute;left:20px;top:41px;font-size:10.5px;line-height:14px;color:#6B665D;white-space:nowrap;'>Share of total relationship value by client quintile</div><div style='position:absolute;right:20px;top:20px;padding:0 12px;height:25px;line-height:25px;border-radius:12.5px;background:#FFFFFF;font-size:10.5px;font-weight:700;white-space:nowrap;'>Top 20% = "
			        & IF ( ISBLANK ( _bottom ), "–", FORMAT ( DIVIDE ( _top, _bottom ), "0.0" ) ) & "× bottom 20%</div>"
			        & "<svg style='position:absolute;left:20px;top:78px;' width='450' height='230' viewBox='0 0 450 230'>"
			        & "<line x1='0' y1='196.5' x2='450' y2='196.5' stroke='#E2DCD0' stroke-width='1'/>" & _cols & "</svg>"
			        & "<div style='position:absolute;left:20px;top:318px;font-size:10px;line-height:14px;color:#6B665D;white-space:nowrap;'>Quintiles rank all 3,000 clients by relationship value, so each fifth is 600 clients.</div></div>"
		lineageTag: 6ba0b300-3405-5a7a-b404-352a66d46efb

	measure 'Tier Value HTML' =
			-- Gold panel: average relationship value per loyalty tier; the title checks the data before claiming it
			VAR _vals = ADDCOLUMNS ( DATATABLE ( "Tier", STRING, "Order", INTEGER, { { "Jade", 1 }, { "Silver", 2 }, { "Gold", 3 }, { "Platinum", 4 } } ), "@n", VAR _t = [Tier] RETURN CALCULATE ( [Avg Relationship Value], banking_clients[loyalty_classification] = _t ) )
			VAR _max = MAXX ( _vals, [@n] )
			VAR _plat = MAXX ( FILTER ( _vals, [Tier] = "Platinum" ), [@n] )
			VAR _jade = MAXX ( FILTER ( _vals, [Tier] = "Jade" ), [@n] )
			VAR _bestOther = MAXX ( FILTER ( _vals, [Tier] <> "Platinum" ), [@n] )
			VAR _title = IF ( _plat <= _bestOther, "Higher tiers don't hold more value", "Platinum clients hold the most value" )
			VAR _rows =
			    CONCATENATEX ( _vals,
			        VAR _top = 152 + ( [Order] - 1 ) * 44
			        VAR _w = ROUND ( DIVIDE ( [@n], _max ) * 230, 0 )
			        RETURN
			            "<div style='position:absolute;left:19px;top:" & _top & "px;width:452px;height:34px;border-radius:13px;background:#FFFFFF;'>"
			            & "<div style='position:absolute;left:16px;top:9px;font-size:12px;line-height:16px;font-weight:600;'>" & [Tier] & "</div>"
			            & "<div style='position:absolute;left:110px;top:13px;width:230px;height:8px;border-radius:4px;background:#EFE9DD;overflow:hidden;'>"
			            & "<div style='height:8px;border-radius:4px;background:#17140F;width:" & _w & "px;'></div></div>"
			            & "<div style='position:absolute;right:16px;top:9px;font-size:12px;line-height:16px;font-weight:700;'>" & IF([@n] >= 1000000000, FORMAT([@n] / 1000000000, "0.00") & "bn", IF([@n] >= 1000000, FORMAT([@n] / 1000000, "0.00") & "M", IF([@n] >= 1000, FORMAT([@n] / 1000, "0") & "K", FORMAT([@n], "0")))) & "</div></div>",
			        "", [Order], ASC )
			RETURN
			    "<div style='position:relative;width:490px;height:350px;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:19px;top:20px;font-size:10.5px;line-height:14px;font-weight:700;letter-spacing:1.6px;white-space:nowrap;'>LOYALTY TIERS</div><div style='position:absolute;left:19px;top:42px;width:445px;'><div style='font-size:21px;line-height:26px;font-weight:800;'>" & _title & "</div>"
			        & "<div style='margin-top:8px;font-size:11.5px;line-height:15px;font-weight:500;'>Average relationship value per client. Platinum clients average "
			        & IF(_plat >= 1000000000, FORMAT(_plat / 1000000000, "0.00") & "bn", IF(_plat >= 1000000, FORMAT(_plat / 1000000, "0.00") & "M", IF(_plat >= 1000, FORMAT(_plat / 1000, "0") & "K", FORMAT(_plat, "0")))) & ", Jade clients " & IF(_jade >= 1000000000, FORMAT(_jade / 1000000000, "0.00") & "bn", IF(_jade >= 1000000, FORMAT(_jade / 1000000, "0.00") & "M", IF(_jade >= 1000, FORMAT(_jade / 1000, "0") & "K", FORMAT(_jade, "0")))) & ".</div></div>"
			        & _rows & "</div>"
		lineageTag: 8eb8484c-4451-5672-be0f-ff7d51376312

	measure 'Tier Depth HTML' =
			-- Left bottom panel: cross-sell depth per loyalty tier (products per 100K income, average products, share holding all 6)
			VAR _vals =
			    ADDCOLUMNS ( DATATABLE ( "Tier", STRING, "Order", INTEGER, { { "Jade", 1 }, { "Silver", 2 }, { "Gold", 3 }, { "Platinum", 4 } } ),
			        "@p100", VAR _t = [Tier] RETURN CALCULATE ( [Avg Products per 100K Income], banking_clients[loyalty_classification] = _t ),
			        "@prod", VAR _t = [Tier] RETURN CALCULATE ( [Avg Products Held], banking_clients[loyalty_classification] = _t ),
			        "@all6", VAR _t = [Tier] RETURN CALCULATE ( [Clients With All 6 Products %], banking_clients[loyalty_classification] = _t ) )
			VAR _cards =
			    CONCATENATEX ( _vals,
			        VAR _left = 20 + ( [Order] - 1 ) * 115
			        RETURN
			            "<div style='position:absolute;left:" & _left & "px;top:74px;width:103px;height:150px;border-radius:12px;background:#FFFFFF;text-align:center;'>"
			            & "<div style='margin-top:16px;font-size:12px;line-height:16px;font-weight:700;'>" & [Tier] & "</div>"
			            & "<div style='margin-top:10px;font-size:25px;line-height:30px;font-weight:800;'>" & FORMAT ( [@p100], "0.00" ) & "</div>"
			            & "<div style='font-size:9.5px;line-height:13px;color:#6B665D;'>products per<br>100K income</div>"
			            & "<div style='margin:10px auto 0;width:60px;height:1px;background:#EAE4D8;'></div>"
			            & "<div style='margin-top:9px;font-size:10px;line-height:14px;color:#2F2B26;'>avg " & FORMAT ( [@prod], "0.00" ) & " products</div>"
			            & "<div style='font-size:10px;line-height:14px;color:#6B665D;'>" & FORMAT ( COALESCE ( [@all6], 0 ), "0.0%" ) & " hold all 6</div></div>",
			        "", [Order], ASC )
			RETURN
			    "<div style='position:relative;width:490px;height:292px;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:20px;top:18px;font-size:16.5px;line-height:22px;font-weight:800;'>Cross-sell depth by tier</div><div style='position:absolute;left:20px;top:41px;font-size:10.5px;line-height:14px;color:#6B665D;white-space:nowrap;'>Products held per 100K of estimated income, by loyalty tier</div>"
			        & _cards
			        & "<div style='position:absolute;left:20px;top:240px;width:450px;font-size:10.5px;line-height:15px;color:#4A463F;'>Every tier holds close to 6 products, so cross-sell depth barely changes from tier to tier.</div></div>"
		lineageTag: be45870d-22ae-52a9-ab05-39c38282e15c

	measure 'Wealth Finding HTML' =
			-- Dark panel: key finding with live numbers for the current selection
			VAR _segment = IF ( ISFILTERED ( banking_clients[banking_relationship] ), IF ( HASONEVALUE ( banking_clients[banking_relationship] ), VALUES ( banking_clients[banking_relationship] ) & " clients", "Selected clients" ), "All clients" )
			VAR _all = CALCULATE ( [Total Relationship Value], REMOVEFILTERS ( banking_clients[value_quintile] ) )
			VAR _top = DIVIDE ( CALCULATE ( [Total Relationship Value], banking_clients[value_quintile] = "Top 20%" ), _all )
			VAR _all6 = [Clients With All 6 Products %]
			RETURN
			    "<div style='position:relative;width:490px;height:292px;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#FFFFFF;'><div style='position:absolute;left:24px;top:24px;font-size:9.5px;line-height:13px;font-weight:700;letter-spacing:1.2px;color:#DCC994;white-space:nowrap;'>KEY FINDING</div><div style='position:absolute;left:24px;top:44px;width:440px;font-size:21px;line-height:27px;font-weight:700;'>Value is concentrated,<br>cross-sell is not the gap.</div><div style='position:absolute;left:24px;top:112px;font-size:34px;line-height:40px;font-weight:800;color:#D9BC7E;'>"
			        & FORMAT ( COALESCE ( _all6, 0 ), "0.0%" ) & "</div>"
			        & "<div style='position:absolute;left:24px;top:156px;width:190px;font-size:11px;line-height:15px;color:#D9D4CB;'>of clients already hold all 6 products</div><div style='position:absolute;left:254px;top:112px;font-size:34px;line-height:40px;font-weight:800;color:#D9BC7E;'>"
			        & FORMAT ( COALESCE ( _top, 0 ), "0.0%" ) & "</div>"
			        & "<div style='position:absolute;left:254px;top:156px;width:200px;font-size:11px;line-height:15px;color:#D9D4CB;'>of relationship value sits with the top 20% of clients</div><div style='position:absolute;left:24px;top:248px;font-size:10px;line-height:14px;color:#A8A196;white-space:nowrap;'>Based on "
			        & FORMAT ( [Total Clients], "#,0" ) & " clients" & IF ( _segment = "All clients", "", " · " & _segment ) & ".</div></div>"
		lineageTag: 1712d1d0-a5ea-50df-b445-b2842de4273f

	measure 'Advisors Subtitle HTML' =
			-- Advisors page subtitle (follows the client-type pills)
			"<div style='font-family:Plus Jakarta Sans,Segoe UI,sans-serif;font-size:12.5px;line-height:16px;color:#5E5A52;white-space:nowrap;'>"
			    & [Advisor Count] & " advisors · " & FORMAT ( [Total Clients], "#,0" ) & " clients · how client value differs by advisor</div>"
		lineageTag: 4f05080e-7382-5b8b-a1e8-1c7e3af7bd31

	measure 'Advisor KPI Count HTML' =
			-- KPI card: number of advisors, average clients each, clients per advisor (sorted, one bar per advisor)
			VAR _n = [Advisor Count]
			VAR _t = ADDCOLUMNS ( VALUES ( banking_clients[investment_advisor] ), "@n", [Total Clients] )
			VAR _max = MAXX ( _t, [@n] )
			VAR _bars =
			    CONCATENATEX ( _t,
			        VAR _cur = [@n]
			        VAR _name = banking_clients[investment_advisor]
			        VAR _rank = COUNTROWS ( FILTER ( _t, [@n] > _cur || ( [@n] = _cur && banking_clients[investment_advisor] < _name ) ) ) + 1
			        VAR _h = ROUND ( DIVIDE ( _cur, _max ) * 42, 1 )
			        RETURN "<rect x='" & FORMAT ( ( _rank - 1 ) * 3.4, "0.0" ) & "' y='" & FORMAT ( 42 - _h, "0.0" )
			            & "' width='2.4' height='" & FORMAT ( _h, "0.0" ) & "' rx='1' fill='#E5D6AF'/>",
			        "" )
			RETURN
			    "<div style='position:relative;width:322px;height:111px;overflow:hidden;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:19px;top:24px;font-size:12.5px;line-height:16px;font-weight:500;color:#2F2B26;white-space:nowrap;'>Advisors</div><div style='position:absolute;left:70px;top:57px;font-size:27px;line-height:34px;font-weight:700;letter-spacing:-0.3px;white-space:nowrap;'>" & _n & "</div>"
			        & "<div style='position:absolute;left:160px;top:60px;font-size:11px;line-height:15px;font-weight:600;color:#6B665D;white-space:nowrap;'>" & "avg " & FORMAT ( DIVIDE ( [Total Clients], _n ), "0" ) & "<br>clients each</div>"
			        & "<svg style='position:absolute;left:240px;top:24px;' width='75' height='42' viewBox='0 0 75 42'>" & _bars & "</svg>"
			        & "<div style='position:absolute;left:240px;top:68px;font-size:9px;line-height:13px;color:#6B665D;white-space:nowrap;'>Clients per<br>advisor</div></div>"
		lineageTag: 42ef26d6-f60f-582d-9835-56d7a51febf6

	measure 'Advisor KPI Gap HTML' =
			-- KPI card: how much higher the top advisor's average client value is than the bottom advisor's
			VAR _t = ADDCOLUMNS ( VALUES ( banking_clients[investment_advisor] ), "@n", [Avg Relationship Value], "@c", [Total Clients] )
			VAR _max = MAXX ( _t, [@n] )
			VAR _min = MINX ( _t, [@n] )
			VAR _bars =
			    CONCATENATEX ( _t,
			        VAR _rank = RANKX ( _t, [@n], , DESC, DENSE )
			        VAR _h = ROUND ( DIVIDE ( [@n], _max ) * 42, 1 )
			        RETURN "<rect x='" & FORMAT ( ( _rank - 1 ) * 3.4, "0.0" ) & "' y='" & FORMAT ( 42 - _h, "0.0" )
			            & "' width='2.4' height='" & FORMAT ( _h, "0.0" ) & "' rx='1' fill='" & IF ( [@n] = _max, "#C4A66A", "#E5D6AF" ) & "'/>",
			        "" )
			RETURN
			    "<div style='position:relative;width:322px;height:111px;overflow:hidden;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:19px;top:24px;font-size:12.5px;line-height:16px;font-weight:500;color:#2F2B26;white-space:nowrap;'>Top vs bottom advisor</div><div style='position:absolute;left:70px;top:57px;font-size:27px;line-height:34px;font-weight:700;letter-spacing:-0.3px;white-space:nowrap;'>" & FORMAT ( DIVIDE ( _max, _min ) - 1, "+0.0%" ) & "</div>"
			        & "<div style='position:absolute;left:184px;top:60px;font-size:11px;line-height:15px;font-weight:600;color:#6B665D;white-space:nowrap;'>" & IF(_max >= 1000000000, FORMAT(_max / 1000000000, "0.00") & "bn", IF(_max >= 1000000, FORMAT(_max / 1000000, "0.00") & "M", IF(_max >= 1000, FORMAT(_max / 1000, "0") & "K", FORMAT(_max, "0")))) & " vs<br>" & IF(_min >= 1000000000, FORMAT(_min / 1000000000, "0.00") & "bn", IF(_min >= 1000000, FORMAT(_min / 1000000, "0.00") & "M", IF(_min >= 1000, FORMAT(_min / 1000, "0") & "K", FORMAT(_min, "0")))) & "</div>"
			        & "<svg style='position:absolute;left:240px;top:24px;' width='75' height='42' viewBox='0 0 75 42'>" & _bars & "</svg>"
			        & "<div style='position:absolute;left:240px;top:68px;font-size:9px;line-height:13px;color:#6B665D;white-space:nowrap;'>Avg client value,<br>per advisor</div></div>"
		lineageTag: d723e2e2-b8b1-51c3-a96e-03d1a31e16c6

	measure 'Advisor KPI Value HTML' =
			-- KPI card: average client value, and the average per fee structure
			VAR _avg = [Avg Relationship Value]
			VAR _vals = ADDCOLUMNS ( DATATABLE ( "Fee", STRING, "Order", INTEGER, { { "Low", 1 }, { "Mid", 2 }, { "High", 3 } } ), "@n", VAR _f = [Fee] RETURN CALCULATE ( [Avg Relationship Value], banking_clients[fee_structure] = _f ) )
			VAR _max = MAXX ( _vals, [@n] )
			VAR _bars = CONCATENATEX ( _vals,
			        VAR _h = ROUND ( DIVIDE ( [@n], _max ) * 42, 1 )
			        RETURN "<rect x='" & FORMAT ( ( [Order] - 1 ) * 22, "0.0" ) & "' y='" & FORMAT ( 42 - _h, "0.0" )
			            & "' width='14' height='" & FORMAT ( _h, "0.0" ) & "' rx='2' fill='"
			            & IF ( [@n] = _max, "#C4A66A", "#E5D6AF" ) & "'/>",
			        "", [Order], ASC )
			RETURN
			    "<div style='position:relative;width:322px;height:111px;overflow:hidden;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:19px;top:24px;font-size:12.5px;line-height:16px;font-weight:500;color:#2F2B26;white-space:nowrap;'>Average client value</div><div style='position:absolute;left:70px;top:57px;font-size:27px;line-height:34px;font-weight:700;letter-spacing:-0.3px;white-space:nowrap;'>" & IF(_avg >= 1000000000, FORMAT(_avg / 1000000000, "0.00") & "bn", IF(_avg >= 1000000, FORMAT(_avg / 1000000, "0.00") & "M", IF(_avg >= 1000, FORMAT(_avg / 1000, "0") & "K", FORMAT(_avg, "0")))) & "</div>"
			        & "<div style='position:absolute;left:160px;top:60px;font-size:11px;line-height:15px;font-weight:600;color:#6B665D;white-space:nowrap;'>" & "across<br>" & [Advisor Count] & " advisors</div>"
			        & "<svg style='position:absolute;left:244px;top:24px;' width='58' height='42' viewBox='0 0 58 42'>" & _bars & "</svg>"
			        & "<div style='position:absolute;left:244px;top:68px;font-size:9px;line-height:13px;color:#6B665D;white-space:nowrap;'>By fee structure,<br>Low → High</div></div>"
		lineageTag: ba526e7a-e2d3-5550-a721-649f5dd69cd7

	measure 'Advisor Ranking HTML' =
			-- Left panel: every advisor ranked by average relationship value, with a dashed bank-average line
			VAR _t = ADDCOLUMNS ( VALUES ( banking_clients[investment_advisor] ), "@n", [Avg Relationship Value], "@c", [Total Clients] )
			VAR _max = MAXX ( _t, [@n] )
			VAR _bank = [Avg Relationship Value]
			VAR _avgX = 170 + ROUND ( DIVIDE ( _bank, _max ) * 230, 0 )
			VAR _rows =
			    CONCATENATEX ( _t,
			        VAR _rank = RANKX ( _t, [@n], , DESC, DENSE )
			        VAR _top = 80 + ( _rank - 1 ) * 24.5
			        VAR _w = ROUND ( DIVIDE ( [@n], _max ) * 230, 0 )
			        RETURN
			            "<div style='position:absolute;left:14px;top:" & _top & "px;width:22px;text-align:right;font-size:10px;line-height:15px;color:#6B665D;'>" & _rank & "</div>"
			            & "<div style='position:absolute;left:44px;top:" & _top & "px;width:122px;font-size:11px;line-height:15px;color:#2F2B26;white-space:nowrap;overflow:hidden;'>"
			            & banking_clients[investment_advisor] & "</div>"
			            & "<div style='position:absolute;left:170px;top:" & ( _top + 4 ) & "px;width:230px;height:8px;border-radius:4.0px;background:#FFFFFF;overflow:hidden;'><div style='height:8px;border-radius:4.0px;background:" & IF ( _rank = 1, "#17140F", "#C4A66A" ) & ";width:" & _w & "px;'></div></div>"
			            & "<div style='position:absolute;right:20px;top:" & _top & "px;font-size:11px;line-height:15px;font-weight:700;'>" & IF([@n] >= 1000000000, FORMAT([@n] / 1000000000, "0.00") & "bn", IF([@n] >= 1000000, FORMAT([@n] / 1000000, "0.00") & "M", IF([@n] >= 1000, FORMAT([@n] / 1000, "0") & "K", FORMAT([@n], "0")))) & "</div>",
			        "" )
			RETURN
			    "<div style='position:relative;width:490px;height:658px;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:20px;top:18px;font-size:16.5px;line-height:22px;font-weight:800;'>Advisor ranking</div><div style='position:absolute;left:20px;top:41px;font-size:10.5px;line-height:14px;color:#6B665D;white-space:nowrap;'>Average relationship value per client, every advisor ranked</div><div style='position:absolute;right:20px;top:20px;padding:0 12px;height:25px;line-height:25px;border-radius:12.5px;background:#FFFFFF;font-size:10.5px;font-weight:700;white-space:nowrap;'>Bank average "
			        & IF(_bank >= 1000000000, FORMAT(_bank / 1000000000, "0.00") & "bn", IF(_bank >= 1000000, FORMAT(_bank / 1000000, "0.00") & "M", IF(_bank >= 1000, FORMAT(_bank / 1000, "0") & "K", FORMAT(_bank, "0")))) & "</div>"
			        & _rows
			        & "<div style='position:absolute;left:" & _avgX & "px;top:78px;height:" & ( 24.5 * COUNTROWS ( _t ) - 6 ) & "px;border-left:1.5px dashed #8C8478;'></div>"
			        & "<div style='position:absolute;left:20px;top:632px;font-size:10px;line-height:14px;color:#6B665D;white-space:nowrap;'>Black bar: highest average. Dashed line: bank average for the clients in the selection.</div></div>"
		lineageTag: d7c57517-65ff-5c2e-8762-bf8eb5871404

	measure 'Advisor Spread HTML' =
			-- Gold panel: the highest and lowest advisor by average client value
			VAR _t = ADDCOLUMNS ( VALUES ( banking_clients[investment_advisor] ), "@n", [Avg Relationship Value], "@c", [Total Clients] )
			VAR _hiRow = TOPN ( 1, _t, [@n], DESC )
			VAR _loRow = TOPN ( 1, _t, [@n], ASC )
			VAR _hiName = MAXX ( _hiRow, banking_clients[investment_advisor] )
			VAR _loName = MAXX ( _loRow, banking_clients[investment_advisor] )
			VAR _hi = MAXX ( _hiRow, [@n] )
			VAR _lo = MAXX ( _loRow, [@n] )
			VAR _hiC = MAXX ( _hiRow, [@c] )
			VAR _loC = MAXX ( _loRow, [@c] )
			VAR _card = "<div style='position:absolute;top:96px;width:214px;height:88px;border-radius:13px;background:#FFFFFF;"
			RETURN
			    "<div style='position:relative;width:490px;height:202px;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:19px;top:18px;font-size:10.5px;line-height:14px;font-weight:700;letter-spacing:1.6px;white-space:nowrap;'>ADVISOR SPREAD</div><div style='position:absolute;left:19px;top:38px;font-size:19px;line-height:24px;font-weight:800;white-space:nowrap;'>A "
			        & FORMAT ( DIVIDE ( _hi, _lo ) - 1, "0.0%" ) & " gap from top to bottom advisor</div>"
			        & _card & "left:19px;'>"
			        & "<div style='position:absolute;left:16px;top:14px;font-size:9.5px;line-height:12px;font-weight:700;letter-spacing:1.2px;color:#A8894A;'>HIGHEST</div><div style='position:absolute;left:16px;top:31px;font-size:14px;line-height:18px;font-weight:700;white-space:nowrap;'>" & _hiName & "</div>"
			        & "<div style='position:absolute;left:16px;top:53px;font-size:10.5px;line-height:14px;color:#6B665D;white-space:nowrap;'>" & IF(_hi >= 1000000000, FORMAT(_hi / 1000000000, "0.00") & "bn", IF(_hi >= 1000000, FORMAT(_hi / 1000000, "0.00") & "M", IF(_hi >= 1000, FORMAT(_hi / 1000, "0") & "K", FORMAT(_hi, "0")))) & " avg · " & _hiC & " clients</div></div>"
			        & _card & "left:257px;'>"
			        & "<div style='position:absolute;left:16px;top:14px;font-size:9.5px;line-height:12px;font-weight:700;letter-spacing:1.2px;color:#A8894A;'>LOWEST</div><div style='position:absolute;left:16px;top:31px;font-size:14px;line-height:18px;font-weight:700;white-space:nowrap;'>" & _loName & "</div>"
			        & "<div style='position:absolute;left:16px;top:53px;font-size:10.5px;line-height:14px;color:#6B665D;white-space:nowrap;'>" & IF(_lo >= 1000000000, FORMAT(_lo / 1000000000, "0.00") & "bn", IF(_lo >= 1000000, FORMAT(_lo / 1000000, "0.00") & "M", IF(_lo >= 1000, FORMAT(_lo / 1000, "0") & "K", FORMAT(_lo, "0")))) & " avg · " & _loC & " clients</div></div></div>"
		lineageTag: 96b5bda5-017b-5173-9049-b6d36a59ca4e

	measure 'Fee Structure HTML' =
			-- Right middle panel: average relationship value per fee structure; the footnote checks how big the difference is
			VAR _vals =
			    ADDCOLUMNS ( DATATABLE ( "Fee", STRING, "Order", INTEGER, { { "Low", 1 }, { "Mid", 2 }, { "High", 3 } } ),
			        "@n", VAR _f = [Fee] RETURN CALCULATE ( [Avg Relationship Value], banking_clients[fee_structure] = _f ),
			        "@c", VAR _f = [Fee] RETURN CALCULATE ( [Total Clients], banking_clients[fee_structure] = _f ) )
			VAR _max = MAXX ( _vals, [@n] )
			VAR _min = MINX ( _vals, [@n] )
			VAR _best = MAXX ( TOPN ( 1, _vals, [@n], DESC ), [Fee] )
			VAR _note =
			    IF ( DIVIDE ( _max, _min ) - 1 < 0.05,
			        "Fee level makes little difference: the gap between fee groups is " & FORMAT ( DIVIDE ( _max, _min ) - 1, "0.0%" ) & ".",
			        "Clients on the " & LOWER ( _best ) & " fee hold the most value, " & FORMAT ( DIVIDE ( _max, _min ) - 1, "0.0%" ) & " above the lowest group." )
			VAR _rows =
			    CONCATENATEX ( _vals,
			        VAR _top = 72 + ( [Order] - 1 ) * 38
			        VAR _w = ROUND ( DIVIDE ( [@n], _max ) * 250, 0 )
			        RETURN
			            "<div style='position:absolute;left:20px;top:" & _top & "px;font-size:12px;line-height:16px;font-weight:600;'>" & [Fee] & "</div>"
			            & "<div style='position:absolute;left:20px;top:" & ( _top + 16 ) & "px;font-size:9.5px;line-height:12px;color:#6B665D;'>" & FORMAT ( [@c], "#,0" ) & " clients</div>"
			            & "<div style='position:absolute;left:110px;top:" & ( _top + 6 ) & "px;width:250px;height:10px;border-radius:5.0px;background:#FFFFFF;overflow:hidden;'><div style='height:10px;border-radius:5.0px;background:" & IF ( [@n] = _max, "#17140F", "#C4A66A" ) & ";width:" & _w & "px;'></div></div>"
			            & "<div style='position:absolute;right:20px;top:" & ( _top + 3 ) & "px;font-size:12px;line-height:16px;font-weight:700;'>" & IF([@n] >= 1000000000, FORMAT([@n] / 1000000000, "0.00") & "bn", IF([@n] >= 1000000, FORMAT([@n] / 1000000, "0.00") & "M", IF([@n] >= 1000, FORMAT([@n] / 1000, "0") & "K", FORMAT([@n], "0")))) & "</div>",
			        "", [Order], ASC )
			RETURN
			    "<div style='position:relative;width:490px;height:213px;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:20px;top:18px;font-size:16.5px;line-height:22px;font-weight:800;'>Value by fee structure</div><div style='position:absolute;left:20px;top:41px;font-size:10.5px;line-height:14px;color:#6B665D;white-space:nowrap;'>Average relationship value per client</div>"
			        & _rows
			        & "<div style='position:absolute;left:20px;top:188px;font-size:10px;line-height:14px;color:#4A463F;white-space:nowrap;'>" & _note & "</div></div>"
		lineageTag: b6c46f21-e4ec-510c-b658-3b3b663dad02

	measure 'Age Band Income HTML' =
			-- Right bottom panel: total estimated income per age band, with each band's share
			VAR _vals = ADDCOLUMNS ( DATATABLE ( "Band", STRING, "Order", INTEGER, { { "Under 35", 1 }, { "35–59", 2 }, { "60+", 3 } } ), "@n", VAR _b = [Band] RETURN CALCULATE ( SUM ( banking_clients[estimated_income] ), banking_clients[Age Band] = _b ) )
			VAR _total = SUMX ( _vals, [@n] )
			VAR _max = MAXX ( _vals, [@n] )
			VAR _over35 = DIVIDE ( SUMX ( FILTER ( _vals, [Order] > 1 ), [@n] ), _total )
			VAR _rows =
			    CONCATENATEX ( _vals,
			        VAR _top = 72 + ( [Order] - 1 ) * 38
			        VAR _w = ROUND ( DIVIDE ( [@n], _max ) * 250, 0 )
			        RETURN
			            "<div style='position:absolute;left:20px;top:" & ( _top + 3 ) & "px;font-size:12px;line-height:16px;font-weight:600;'>" & [Band] & "</div>"
			            & "<div style='position:absolute;left:110px;top:" & ( _top + 6 ) & "px;width:250px;height:10px;border-radius:5.0px;background:#FFFFFF;overflow:hidden;'><div style='height:10px;border-radius:5.0px;background:" & IF ( [@n] = _max, "#17140F", "#C4A66A" ) & ";width:" & _w & "px;'></div></div>"
			            & "<div style='position:absolute;right:20px;top:" & ( _top + 3 ) & "px;font-size:12px;line-height:16px;font-weight:700;white-space:nowrap;'>"
			            & IF([@n] >= 1000000000, FORMAT([@n] / 1000000000, "0.00") & "bn", IF([@n] >= 1000000, FORMAT([@n] / 1000000, "0.00") & "M", IF([@n] >= 1000, FORMAT([@n] / 1000, "0") & "K", FORMAT([@n], "0")))) & "<span style='font-weight:400;color:#6B665D;'> · " & FORMAT ( DIVIDE ( [@n], _total ), "0%" ) & "</span></div>",
			        "", [Order], ASC )
			RETURN
			    "<div style='position:relative;width:490px;height:211px;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:20px;top:18px;font-size:16.5px;line-height:22px;font-weight:800;'>Income by age band</div><div style='position:absolute;left:20px;top:41px;font-size:10.5px;line-height:14px;color:#6B665D;white-space:nowrap;'>Total estimated income of clients in each age band</div>"
			        & _rows
			        & "<div style='position:absolute;left:20px;top:186px;font-size:10px;line-height:14px;color:#4A463F;white-space:nowrap;'>Clients aged 35 and over earn "
			        & FORMAT ( COALESCE ( _over35, 0 ), "0%" ) & " of the total estimated income.</div></div>"
		lineageTag: b7ee488f-7660-56e5-a143-8272eefbd6b2

