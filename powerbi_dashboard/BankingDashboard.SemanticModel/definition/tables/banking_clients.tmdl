		dataType: double
		formatString: #,##0.00
		sourceColumn: total_relationship_value
		summarizeBy: sum

	column value_quintile
		dataType: string
		sourceColumn: value_quintile
		summarizeBy: none

	column product_count
		dataType: int64
		formatString: #,##0
		sourceColumn: product_count
		summarizeBy: average

	column products_per_100k_income
		dataType: double
		formatString: #,##0.00
		sourceColumn: products_per_100k_income
