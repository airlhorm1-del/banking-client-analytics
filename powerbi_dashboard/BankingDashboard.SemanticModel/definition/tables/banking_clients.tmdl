table banking_clients
	lineageTag: fc671e6d-95d1-4f00-9d26-b4a4dbab74ba

	measure 'Total Clients' = COUNTROWS(banking_clients)
		formatString: 0
		lineageTag: 0ef0345b-de23-418d-8efa-99c70284ab53

	measure 'Total Relationship Value' = SUM(banking_clients[total_relationship_value])
		lineageTag: 3e93ad5e-831c-4f65-b241-e7121ec97aa1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Relationship Value' = AVERAGE(banking_clients[total_relationship_value])
		lineageTag: df3accfa-8eeb-4c65-9be8-44dce946f4c2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Risk Weighting' = AVERAGE(banking_clients[risk_weighting])
		lineageTag: 3b1face0-6af4-4fae-a43b-cbab6c38ed64

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Estimated Income' = AVERAGE(banking_clients[estimated_income])
		lineageTag: cc7baea9-e7f0-4c4a-af22-fe54af77ee8b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Products Held' = AVERAGE(banking_clients[product_count])
		lineageTag: 894ad79c-c167-4f74-b1d6-306d69b642ee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Products per 100K Income' = AVERAGE(banking_clients[products_per_100k_income])
		lineageTag: 05e968d5-57e5-4d5c-a84f-d44c5922a706

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Share of Total Value' = DIVIDE([Total Relationship Value], CALCULATE([Total Relationship Value], ALL(banking_clients)))
		lineageTag: 1d3625e2-ae29-4b82-a318-205831c4fe4c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top 20% Share' = CALCULATE([Share of Total Value], banking_clients[value_quintile] = "Top 20%")
		formatString: 0.0%
		lineageTag: b62ce558-83a8-48d8-aeab-04965618b382

	measure 'High Risk Clients %' = DIVIDE(CALCULATE([Total Clients], banking_clients[risk_weighting] >= 4), [Total Clients])
		formatString: 0.0%
		lineageTag: 1501b934-9c88-4a39-8039-db80a4e4dcee

	measure 'High Risk Value' = CALCULATE([Total Relationship Value], banking_clients[risk_weighting] >= 4)
		formatString: #,##0.00
		lineageTag: 0b841079-0f49-496c-9aeb-49548ceb2139

	measure 'Clients With All 6 Products %' = DIVIDE(CALCULATE([Total Clients], banking_clients[product_count] = 6), [Total Clients])
		formatString: 0.0%
		lineageTag: 3fe3916f-01ad-4208-b57f-c4898de7292d

	measure 'Advisor Count' = DISTINCTCOUNT(banking_clients[investment_advisor])
		formatString: #,##0
		lineageTag: e7b2cf03-2cb4-49fd-8c19-b4f50b1895ea

	measure 'Quintile List HTML' =
			-- HTML for the HTML Content visual in the gold card: one white row per value quintile
			-- with a gold dot (filled for Top 20%), its label and its share of relationship value.
			-- Shares use the current selection (slicers still apply), so the 5 rows add up to 100%.
			VAR _total =
			    CALCULATE ( [Total Relationship Value], REMOVEFILTERS ( banking_clients[value_quintile] ) )
			VAR _quintiles =
			    DATATABLE (
			        "Quintile", STRING,
			        "Label", STRING,
			        "Order", INTEGER,
			        {
			            { "Top 20%", "Top 20%", 1 },
			            { "4th", "4th quintile", 2 },
			            { "3rd", "3rd quintile", 3 },
			            { "2nd", "2nd quintile", 4 },
			            { "Bottom 20%", "Bottom 20%", 5 }
			        }
			    )
			VAR _rows =
			    CONCATENATEX (
			        _quintiles,
			        VAR _q = [Quintile]
			        VAR _share =
			            DIVIDE (
			                CALCULATE ( [Total Relationship Value], banking_clients[value_quintile] = _q ),
			                _total
			            )
			        VAR _dotFill = IF ( [Order] = 1, "#A8894A", "#FFFFFF" )
			        VAR _gap = IF ( [Order] = 5, "0", "10px" )
			        RETURN
			            "<div style=""display:flex;align-items:center;box-sizing:border-box;height:28px;margin-bottom:" & _gap
			                & ";padding:0 14px;background:#FFFFFF;border-radius:13px;"">"
			                & "<span style=""display:inline-block;box-sizing:border-box;width:13px;height:13px;border-radius:50%;border:1.5px solid #A8894A;background:"
			                & _dotFill & ";""></span>"
			                & "<span style=""margin-left:12px;font-size:12px;font-weight:500;"">" & [Label] & "</span>"
			                & "<span style=""margin-left:auto;font-size:12px;font-weight:700;"">"
			                & FORMAT ( COALESCE ( _share, 0 ), "0.0%" ) & "</span>"
			                & "</div>",
			        "",
			        [Order], ASC
			    )
			RETURN
			    "<div style=""font-family:'Plus Jakarta Sans','Segoe UI',sans-serif;color:#17140F;"">" & _rows & "</div>"
		lineageTag: c8e3a8b6-3302-43ce-b0a6-42ade7f237a6

	measure 'Overview Subtitle HTML' =
			-- Page subtitle, e.g. 3,000 clients · 4 relationship types (follows the client-type slicer)
			VAR _n = [Total Clients]
			VAR _types = DISTINCTCOUNT ( banking_clients[banking_relationship] )
			RETURN
			    "<div style='font-family:Plus Jakarta Sans,Segoe UI,sans-serif;font-size:12.5px;line-height:16px;color:#5E5A52;white-space:nowrap;'>"
			        & FORMAT ( _n, "#,0" ) & " clients · " & _types
			        & IF ( _types = 1, " relationship type", " relationship types" ) & "</div>"
		lineageTag: 42e1e7f3-63ab-5317-8d88-e53ccdddd94b

	measure 'KPI Value HTML' =
			-- KPI card: total relationship value, share of the whole book, clients by year joined (6 bins)
			VAR _v = [Total Relationship Value]
			VAR _book = DIVIDE ( _v, CALCULATE ( [Total Relationship Value], ALL ( banking_clients ) ) )
			VAR _bins =
			    DATATABLE ( "Start", INTEGER, "End", INTEGER, "Order", INTEGER,
			        { { 1995, 1999, 1 }, { 2000, 2004, 2 }, { 2005, 2009, 3 }, { 2010, 2014, 4 }, { 2015, 2019, 5 }, { 2020, 2021, 6 } } )
			VAR _counts =
			    ADDCOLUMNS ( _bins, "@n",
			        VAR _s = [Start]
			        VAR _e = [End]
			        RETURN CALCULATE ( [Total Clients],
			            FILTER ( ALL ( banking_clients[joined_bank_date] ),
			                YEAR ( banking_clients[joined_bank_date] ) >= _s && YEAR ( banking_clients[joined_bank_date] ) <= _e ) ) )
			VAR _max = MAXX ( _counts, [@n] )
			VAR _bars =
			    CONCATENATEX ( _counts,
			        VAR _h = ROUND ( DIVIDE ( [@n], _max ) * 42, 1 )
			        RETURN "<rect x='" & FORMAT ( ( [Order] - 1 ) * 14, "0.0" ) & "' y='" & FORMAT ( 42 - _h, "0.0" )
			            & "' width='10.5' height='" & FORMAT ( _h, "0.0" ) & "' rx='2' fill='"
			            & IF ( [@n] = _max, "#C4A66A", "#E5D6AF" ) & "'/>",
			        "", [Order], ASC )
			RETURN
			    "<div style='position:relative;width:322px;height:111px;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:19px;top:24px;font-size:12.5px;line-height:16px;font-weight:500;color:#2F2B26;white-space:nowrap;'>Total relationship value</div><div style='position:absolute;left:70px;top:57px;font-size:27px;line-height:34px;font-weight:700;letter-spacing:-0.3px;white-space:nowrap;'>" & IF(_v >= 1000000000, FORMAT(_v / 1000000000, "0.00") & "bn", IF(_v >= 1000000, FORMAT(_v / 1000000, "0.00") & "M", IF(_v >= 1000, FORMAT(_v / 1000, "0") & "K", FORMAT(_v, "0")))) & "</div>"
			        & "<div style='position:absolute;left:176px;top:60px;font-size:11.5px;line-height:15px;font-weight:600;color:#3F6B4B;white-space:nowrap;'>" & FORMAT ( COALESCE ( _book, 0 ), "0%" ) & " of<br>book</div>"
			        & "<svg style='position:absolute;left:232px;top:23px;' width='81' height='42' viewBox='0 0 81 42'>" & _bars & "</svg>"
			        & "<div style='position:absolute;left:232px;top:68px;font-size:9px;line-height:13px;color:#6B665D;white-space:nowrap;'>Clients by year<br>joined, 1995–2021</div></div>"
		lineageTag: 8d850f3b-66d2-589f-9743-2bd3cb267123

	measure 'KPI Clients HTML' =
			-- KPI card: client count, share in the Jade tier, clients per loyalty tier
			VAR _n = [Total Clients]
			VAR _jade = DIVIDE ( CALCULATE ( [Total Clients], banking_clients[loyalty_classification] = "Jade" ), _n )
			VAR _tiers =
			    DATATABLE ( "Tier", STRING, "Order", INTEGER, { { "Jade", 1 }, { "Silver", 2 }, { "Gold", 3 }, { "Platinum", 4 } } )
			VAR _counts =
			    ADDCOLUMNS ( _tiers, "@n", VAR _t = [Tier] RETURN CALCULATE ( [Total Clients], banking_clients[loyalty_classification] = _t ) )
			VAR _max = MAXX ( _counts, [@n] )
			VAR _bars =
			    CONCATENATEX ( _counts,
			        VAR _h = ROUND ( DIVIDE ( [@n], _max ) * 42, 1 )
			        RETURN "<rect x='" & FORMAT ( ( [Order] - 1 ) * 18, "0" ) & "' y='" & FORMAT ( 42 - _h, "0.0" )
			            & "' width='12' height='" & FORMAT ( _h, "0.0" ) & "' rx='2' fill='"
			            & IF ( [@n] = _max, "#C4A66A", "#E5D6AF" ) & "'/>",
			        "", [Order], ASC )
			RETURN
			    "<div style='position:relative;width:322px;height:111px;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:19px;top:24px;font-size:12.5px;line-height:16px;font-weight:500;color:#2F2B26;white-space:nowrap;'>Clients</div><div style='position:absolute;left:70px;top:57px;font-size:27px;line-height:34px;font-weight:700;letter-spacing:-0.3px;white-space:nowrap;'>" & FORMAT ( _n, "#,0" ) & "</div>"
			        & "<div style='position:absolute;left:176px;top:60px;font-size:11.5px;line-height:15px;font-weight:600;color:#3F6B4B;white-space:nowrap;'>" & FORMAT ( COALESCE ( _jade, 0 ), "0%" ) & "<br>Jade</div>"
			        & "<svg style='position:absolute;left:226px;top:24px;' width='66' height='42' viewBox='0 0 66 42'>" & _bars & "</svg>"
			        & "<div style='position:absolute;left:214px;top:68px;font-size:9px;line-height:13px;color:#6B665D;white-space:nowrap;'>Jade · Silver · Gold ·<br>Plat.</div></div>"
		lineageTag: cf67d1b8-26c9-583c-813d-05124fb96ed0

	measure 'KPI Risk HTML' =
			-- KPI card: average risk weighting out of 5, clients at each risk level 1 to 5
			VAR _avg = [Avg Risk Weighting]
			VAR _levels = SELECTCOLUMNS ( GENERATESERIES ( 1, 5, 1 ), "Level", [Value] )
			VAR _counts = ADDCOLUMNS ( _levels, "@n", VAR _l = [Level] RETURN CALCULATE ( [Total Clients], banking_clients[risk_weighting] = _l ) )
			VAR _max = MAXX ( _counts, [@n] )
			VAR _dots =
			    CONCATENATEX ( _counts,
			        "<circle cx='" & FORMAT ( 4 + ( [Level] - 1 ) * 23, "0" ) & "' cy='"
			            & FORMAT ( 47.8 - DIVIDE ( [@n], _max ) * 36.8, "0.0" ) & "' r='3.4' fill='#C4A66A'/>",
			        "", [Level], ASC )
			RETURN
			    "<div style='position:relative;width:322px;height:111px;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:19px;top:24px;font-size:12.5px;line-height:16px;font-weight:500;color:#2F2B26;white-space:nowrap;'>Average risk weighting</div><div style='position:absolute;left:70px;top:57px;font-size:27px;line-height:34px;font-weight:700;letter-spacing:-0.3px;white-space:nowrap;'>" & FORMAT ( _avg, "0.00" ) & "</div>"
			        & "<div style='position:absolute;left:147px;top:67px;font-size:11px;line-height:15px;font-weight:500;color:#6B665D;white-space:nowrap;'>of 5</div>"
			        & "<svg style='position:absolute;left:198px;top:26px;' width='100' height='52' viewBox='0 0 100 52'>" & _dots & "</svg>"
			        & "<div style='position:absolute;left:200px;top:82px;font-size:9px;line-height:13px;color:#6B665D;white-space:nowrap;'>Clients at risk level 1 → 5</div></div>"
		lineageTag: 4a6f67c4-750b-5491-8017-6a2d3b03d638

	measure 'Client Profile HTML' =
			-- Client profile panel: averages per client and the top advisor by average client value
			VAR _segment = IF ( ISFILTERED ( banking_clients[banking_relationship] ), IF ( HASONEVALUE ( banking_clients[banking_relationship] ), VALUES ( banking_clients[banking_relationship] ) & " clients", "Selected clients" ), "All clients" )
			VAR _rv = [Avg Relationship Value]
			VAR _prod = [Avg Products Held]
			VAR _inc = [Avg Estimated Income]
			VAR _topRow = TOPN ( 1, VALUES ( banking_clients[investment_advisor] ), [Avg Relationship Value], DESC )
			VAR _name = MAXX ( _topRow, banking_clients[investment_advisor] )
			VAR _advN = CALCULATE ( [Total Clients], banking_clients[investment_advisor] = _name )
			VAR _advAvg = CALCULATE ( [Avg Relationship Value], banking_clients[investment_advisor] = _name )
			VAR _initials = LEFT ( _name, 1 ) & MID ( _name, FIND ( " ", _name, 1, 0 ) + 1, 1 )
			RETURN
			    "<div style='position:relative;width:322px;height:266px;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:20px;top:18px;font-size:16.5px;line-height:22px;font-weight:800;'>Client profile</div><div style='position:absolute;left:19px;top:41px;font-size:10.5px;line-height:14px;color:#6B665D;white-space:nowrap;'>" & _segment & " · averages per client</div>"
			        & "<div style='position:absolute;left:19px;top:102px;width:89px;font-size:16px;line-height:20px;font-weight:700;text-align:center;'>" & IF(_rv >= 1000000000, FORMAT(_rv / 1000000000, "0.00") & "bn", IF(_rv >= 1000000, FORMAT(_rv / 1000000, "0.00") & "M", IF(_rv >= 1000, FORMAT(_rv / 1000, "0") & "K", FORMAT(_rv, "0")))) & "</div>"
			        & "<div style='position:absolute;left:19px;top:129px;width:89px;font-size:9.5px;line-height:13px;color:#6B665D;text-align:center;'>relationship<br>value</div>"
			        & "<div style='position:absolute;left:117px;top:102px;width:88px;font-size:16px;line-height:20px;font-weight:700;text-align:center;'>" & FORMAT ( _prod, "0.0" ) & "</div>"
			        & "<div style='position:absolute;left:117px;top:129px;width:88px;font-size:9.5px;line-height:13px;color:#6B665D;text-align:center;'>products held</div>"
			        & "<div style='position:absolute;left:214px;top:102px;width:89px;font-size:16px;line-height:20px;font-weight:700;text-align:center;'>" & IF(_inc >= 1000000000, FORMAT(_inc / 1000000000, "0.00") & "bn", IF(_inc >= 1000000, FORMAT(_inc / 1000000, "0.00") & "M", IF(_inc >= 1000, FORMAT(_inc / 1000, "0") & "K", FORMAT(_inc, "0")))) & "</div>"
			        & "<div style='position:absolute;left:214px;top:129px;width:89px;font-size:9.5px;line-height:13px;color:#6B665D;text-align:center;'>estimated<br>income</div>"
			        & "<div style='position:absolute;left:19px;top:180px;font-size:11.5px;line-height:16px;font-weight:600;color:#2F2B26;white-space:nowrap;'>Top advisor by client value</div>"
			        & "<div style='position:absolute;left:19px;top:209px;width:40px;font-size:12px;line-height:40px;font-weight:700;color:#E8D6AE;text-align:center;'>" & _initials & "</div>"
			        & "<div style='position:absolute;left:70px;top:211px;font-size:13.5px;line-height:18px;font-weight:600;white-space:nowrap;'>" & _name & "</div>"
			        & "<div style='position:absolute;left:70px;top:231px;font-size:10.5px;line-height:14px;color:#6B665D;white-space:nowrap;'>"
			        & FORMAT ( _advN, "#,0" ) & " clients · avg " & IF(_advAvg >= 1000000000, FORMAT(_advAvg / 1000000000, "0.00") & "bn", IF(_advAvg >= 1000000, FORMAT(_advAvg / 1000000, "0.00") & "M", IF(_advAvg >= 1000, FORMAT(_advAvg / 1000, "0") & "K", FORMAT(_advAvg, "0")))) & " each</div></div>"
		lineageTag: dded3501-55b0-54e7-af44-ef02e451372f

	measure 'Wealth Headline HTML' =
			-- Top of the gold card: share of value held by the top 20% (within the current selection) and how many times the bottom 20%
			VAR _segment = IF ( ISFILTERED ( banking_clients[banking_relationship] ), IF ( HASONEVALUE ( banking_clients[banking_relationship] ), VALUES ( banking_clients[banking_relationship] ) & " clients", "Selected clients" ), "All clients" )
			VAR _all = CALCULATE ( [Total Relationship Value], REMOVEFILTERS ( banking_clients[value_quintile] ) )
			VAR _top = CALCULATE ( [Total Relationship Value], banking_clients[value_quintile] = "Top 20%" )
			VAR _bottom = CALCULATE ( [Total Relationship Value], banking_clients[value_quintile] = "Bottom 20%" )
			VAR _share = COALESCE ( DIVIDE ( _top, _all ), 0 )
			VAR _ratio = DIVIDE ( _top, _bottom )
			VAR _sentence =
			    IF ( ISFILTERED ( banking_clients[banking_relationship] ),
			        "of " & _segment & "' relationship value sits with clients in the bank-wide top 20%",
			        "of all relationship value sits with the top 20% of clients" )
			RETURN
			    "<div style='position:relative;width:322px;height:180px;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:19px;top:20px;font-size:10.5px;line-height:14px;font-weight:700;letter-spacing:1.6px;white-space:nowrap;'>WEALTH CONCENTRATION</div><div style='position:absolute;left:17px;top:41px;font-size:40px;line-height:46px;font-weight:800;letter-spacing:-0.4px;white-space:nowrap;'>"
			        & FORMAT ( _share, "0.0%" ) & "</div>"
			        & "<div style='position:absolute;left:19px;top:93px;width:280px;font-size:11.5px;line-height:15px;font-weight:500;color:#17140F;'>" & _sentence & "</div>"
			        & "<div style='position:absolute;left:19px;top:136px;width:282px;height:6px;border-radius:3px;background:rgba(255,255,255,0.38);overflow:hidden;'><div style='height:6px;border-radius:3px;background:#FFFFFF;width:" & FORMAT ( _share * 282, "0" ) & "px;'></div></div>"
			        & "<div style='position:absolute;left:19px;top:152px;width:282px;display:flex;justify-content:space-between;font-size:10.5px;line-height:14px;font-weight:600;'><span>Top 20%</span><span>"
			        & IF ( ISBLANK ( _ratio ), "", FORMAT ( _ratio, "0.0" ) & "× the bottom 20%" ) & "</span></div></div>"
		lineageTag: 44ef4cc7-99f9-58b7-8783-b447c0ecec6e

	measure 'Product Book HTML' =
			-- Product book panel: total balances per product, bar length relative to the largest product
			VAR _rows =
			    DATATABLE ( "Label", STRING, "Order", INTEGER,
			        { { "Deposits", 1 }, { "Business lending", 2 }, { "Loans", 3 }, { "Checking", 4 },
			           { "Savings", 5 }, { "Foreign currency", 6 }, { "Superannuation", 7 }, { "Credit cards", 8 } } )
			VAR _vals =
			    ADDCOLUMNS ( _rows, "@v",
			        SWITCH ( [Order],
			            1, SUM ( banking_clients[bank_deposits] ), 2, SUM ( banking_clients[business_lending] ),
			            3, SUM ( banking_clients[bank_loans] ), 4, SUM ( banking_clients[checking_accounts] ),
			            5, SUM ( banking_clients[saving_accounts] ), 6, SUM ( banking_clients[foreign_currency_account] ),
			            7, SUM ( banking_clients[superannuation_savings] ), 8, SUM ( banking_clients[credit_card_balance] ) ) )
			VAR _max = MAXX ( _vals, [@v] )
			VAR _list =
			    CONCATENATEX ( _vals,
			        VAR _top = 50 + ( [Order] - 1 ) * 25
			        VAR _v = [@v]
			        VAR _w = MAX ( 3, ROUND ( DIVIDE ( _v, _max ) * 102, 0 ) )
			        RETURN
			            "<div style='position:absolute;left:20px;top:" & _top & "px;font-size:11.5px;line-height:16px;color:#2F2B26;white-space:nowrap;'>" & [Label] & "</div>"
			            & "<div style='position:absolute;left:135px;top:" & ( _top + 3.5 ) & "px;width:102px;height:9px;border-radius:4.5px;background:#FFFFFF;overflow:hidden;'>"
			            & "<div style='height:9px;border-radius:4.5px;width:" & _w & "px;background:" & IF ( _v >= _max * 0.5, "#17140F", "#C4A66A" ) & ";'></div></div>"
			            & "<div style='position:absolute;right:21px;top:" & _top & "px;font-size:11.5px;line-height:16px;font-weight:700;white-space:nowrap;'>"
			            & IF(_v >= 1000000000, FORMAT(_v / 1000000000, "0.00") & "bn", IF(_v >= 1000000, FORMAT(_v / 1000000, "0.00") & "M", IF(_v >= 1000, FORMAT(_v / 1000, "0") & "K", FORMAT(_v, "0")))) & "</div>",
			        "", [Order], ASC )
			RETURN
			    "<div style='position:relative;width:322px;height:258px;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:20px;top:17px;font-size:16.5px;line-height:22px;font-weight:800;'>Product book</div><div style='position:absolute;right:21px;top:23px;font-size:10.5px;line-height:14px;color:#6B665D;'>Total balances</div>"
			        & _list & "</div>"
		lineageTag: 01dfeeab-2a2b-53eb-b9a2-ff11b0193500

	measure 'Risk Drivers HTML' =
			-- What drives risk panel: Pearson correlation of each client attribute with risk weighting,
			-- recalculated for the current selection, sorted strongest first, plus the key finding box.
			VAR _segment = IF ( ISFILTERED ( banking_clients[banking_relationship] ), IF ( HASONEVALUE ( banking_clients[banking_relationship] ), VALUES ( banking_clients[banking_relationship] ) & " clients", "Selected clients" ), "All clients" )
			VAR _ybar = AVERAGE ( banking_clients[risk_weighting] )
			VAR _syy = SUMX ( banking_clients, ( banking_clients[risk_weighting] - _ybar ) ^ 2 )
			VAR _drivers = DATATABLE ( "Key", STRING, "Label", STRING, { { "income", "Income" }, { "super", "Superannuation" }, { "loans", "Loans" }, { "business", "Business lending" }, { "fx", "Foreign currency" }, { "cards", "Credit card balance" }, { "checking", "Checking" }, { "property", "Properties owned" }, { "age", "Age" } } )
			VAR _withR =
			    ADDCOLUMNS ( _drivers, "@r",
			        VAR _k = [Key]
			        VAR _xbar = AVERAGEX ( banking_clients, SWITCH ( _k, "income", banking_clients[estimated_income], "super", banking_clients[superannuation_savings], "loans", banking_clients[bank_loans], "business", banking_clients[business_lending], "fx", banking_clients[foreign_currency_account], "cards", banking_clients[credit_card_balance], "checking", banking_clients[checking_accounts], "property", banking_clients[properties_owned], "age", banking_clients[age] ) )
			        VAR _sxy = SUMX ( banking_clients, ( SWITCH ( _k, "income", banking_clients[estimated_income], "super", banking_clients[superannuation_savings], "loans", banking_clients[bank_loans], "business", banking_clients[business_lending], "fx", banking_clients[foreign_currency_account], "cards", banking_clients[credit_card_balance], "checking", banking_clients[checking_accounts], "property", banking_clients[properties_owned], "age", banking_clients[age] ) - _xbar ) * ( banking_clients[risk_weighting] - _ybar ) )
			        VAR _sxx = SUMX ( banking_clients, ( SWITCH ( _k, "income", banking_clients[estimated_income], "super", banking_clients[superannuation_savings], "loans", banking_clients[bank_loans], "business", banking_clients[business_lending], "fx", banking_clients[foreign_currency_account], "cards", banking_clients[credit_card_balance], "checking", banking_clients[checking_accounts], "property", banking_clients[properties_owned], "age", banking_clients[age] ) - _xbar ) ^ 2 )
			        RETURN DIVIDE ( _sxy, SQRT ( _sxx * _syy ) ) )
			VAR _ranked = ADDCOLUMNS ( _withR, "@rank", RANKX ( _withR, [@r], , DESC, DENSE ) )
			VAR _fmt = "0.00"
			VAR _rows =
			    CONCATENATEX ( _ranked,
			        VAR _r = [@r]
			        VAR _top = 105 + ( [@rank] - 1 ) * 37.5
			        VAR _w = MIN ( 282, MAX ( 4, ROUND ( DIVIDE ( MAX ( _r, 0 ), 0.75 ) * 282, 0 ) ) )
			        VAR _txt = IF ( ABS ( _r ) < 0.005, "0.00", FORMAT ( _r, _fmt ) )
			        RETURN
			            "<div style='position:absolute;left:19px;top:" & _top & "px;font-size:11.5px;line-height:15px;color:#2F2B26;white-space:nowrap;'>" & [Label] & "</div>"
			            & "<div style='position:absolute;right:21px;top:" & _top & "px;font-size:11.5px;line-height:15px;font-weight:700;'>" & _txt & "</div>"
			            & "<div style='position:absolute;left:19px;top:" & ( _top + 17.5 ) & "px;width:282px;height:7px;border-radius:3.5px;background:#FFFFFF;overflow:hidden;'>"
			            & "<div style='height:7px;border-radius:3.5px;width:" & _w & "px;background:" & IF ( _r >= 0.45, "#17140F", "#C4A66A" ) & ";'></div></div>",
			        "", [@rank], ASC )
			VAR _rIncome = MAXX ( FILTER ( _withR, [Key] = "income" ), [@r] )
			VAR _rAge = MAXX ( FILTER ( _withR, [Key] = "age" ), [@r] )
			VAR _ageTxt = IF ( ABS ( _rAge ) < 0.005, "0.00", FORMAT ( _rAge, _fmt ) )
			RETURN
			    "<div style='position:relative;width:322px;height:658px;font-family:Plus Jakarta Sans,Segoe UI,sans-serif;color:#17140F;'><div style='position:absolute;left:19px;top:18px;font-size:16.5px;line-height:22px;font-weight:800;'>What drives risk</div><div style='position:absolute;left:220px;top:22px;width:82px;font-size:10.5px;line-height:15px;font-weight:700;text-align:center;'>Correlation r</div><div style='position:absolute;left:19px;top:56px;width:275px;font-size:11.5px;line-height:17px;color:#4A463F;'>How strongly each client attribute moves with risk weighting.</div>"
			        & _rows
			        & "<div style='position:absolute;left:36px;top:549px;font-size:9.5px;line-height:13px;font-weight:700;letter-spacing:1.2px;color:#DCC994;white-space:nowrap;'>KEY FINDING</div><div style='position:absolute;left:36px;top:568px;width:252px;font-size:13.5px;line-height:19px;font-weight:600;color:#FFFFFF;'>Risk tracks wealth, not age or property count.</div><div style='position:absolute;left:36px;top:611px;font-size:10.5px;line-height:14px;color:#D9D4CB;white-space:nowrap;'>"
			        & "Income r = " & FORMAT ( _rIncome, _fmt ) & ", age r = " & _ageTxt & " for "
			        & IF ( _segment = "All clients", "all clients", _segment ) & ".</div></div>"
		lineageTag: 0239b64d-b98b-5267-8f05-fea0215e8ab8

