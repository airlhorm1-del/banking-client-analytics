table banking_clients

	measure 'Total Clients' = COUNTROWS(banking_clients)
		formatString: #,##0

	measure 'Total Relationship Value' = SUM(banking_clients[total_relationship_value])
		formatString: #,##0.00

	measure 'Avg Relationship Value' = AVERAGE(banking_clients[total_relationship_value])
		formatString: #,##0.00

	measure 'Avg Risk Weighting' = AVERAGE(banking_clients[risk_weighting])
		formatString: #,##0.0

	measure 'Avg Estimated Income' = AVERAGE(banking_clients[estimated_income])
		formatString: #,##0.00

	measure 'Avg Products Held' = AVERAGE(banking_clients[product_count])
		formatString: #,##0.0

	measure 'Avg Products per 100K Income' = AVERAGE(banking_clients[products_per_100k_income])
		formatString: #,##0.00

	measure 'Share of Total Value' = DIVIDE([Total Relationship Value], CALCULATE([Total Relationship Value], ALL(banking_clients)))
		formatString: 0.0%

	measure 'Total Deposits (All Clients)' = CALCULATE(SUM(banking_clients[bank_deposits]), ALL(banking_clients))
		formatString: #,##0.00

	measure 'Total Loans (All Clients)' = CALCULATE(SUM(banking_clients[bank_loans]), ALL(banking_clients))
		formatString: #,##0.00

	measure 'Total Checking (All Clients)' = CALCULATE(SUM(banking_clients[checking_accounts]), ALL(banking_clients))
		formatString: #,##0.00

	measure 'Total Savings (All Clients)' = CALCULATE(SUM(banking_clients[saving_accounts]), ALL(banking_clients))
		formatString: #,##0.00

	measure 'Total Business Lending (All Clients)' = CALCULATE(SUM(banking_clients[business_lending]), ALL(banking_clients))
		formatString: #,##0.00

	measure 'Total Credit Card Balance (All Clients)' = CALCULATE(SUM(banking_clients[credit_card_balance]), ALL(banking_clients))
		formatString: #,##0.00

	measure 'Total Foreign Currency (All Clients)' = CALCULATE(SUM(banking_clients[foreign_currency_account]), ALL(banking_clients))
		formatString: #,##0.00

	measure 'Total Superannuation (All Clients)' = CALCULATE(SUM(banking_clients[superannuation_savings]), ALL(banking_clients))
		formatString: #,##0.00

	column client_row_id
		dataType: int64
		formatString: #,##0
		sourceColumn: client_row_id
		summarizeBy: none

	column client_id
		dataType: string
		sourceColumn: client_id
		summarizeBy: none

	column name
		dataType: string
		sourceColumn: name
		summarizeBy: none

	column age
		dataType: int64
		formatString: #,##0
		sourceColumn: age
		summarizeBy: average

	column location_id
		dataType: int64
		formatString: #,##0
		sourceColumn: location_id
		summarizeBy: none

	column joined_bank_date
		dataType: dateTime
		formatString: Short Date
		sourceColumn: joined_bank_date
		summarizeBy: none

	column banking_contact
		dataType: string
		sourceColumn: banking_contact
		summarizeBy: none

	column nationality
		dataType: string
		sourceColumn: nationality
		summarizeBy: none

	column occupation
		dataType: string
		sourceColumn: occupation
		summarizeBy: none

	column fee_structure
		dataType: string
		sourceColumn: fee_structure
