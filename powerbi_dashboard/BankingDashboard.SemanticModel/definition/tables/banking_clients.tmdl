	column loyalty_classification
		dataType: string
		sourceColumn: loyalty_classification
		summarizeBy: none

	column estimated_income
		dataType: double
		formatString: #,##0.00
		sourceColumn: estimated_income
		summarizeBy: average

	column superannuation_savings
		dataType: double
		formatString: #,##0.00
		sourceColumn: superannuation_savings
		summarizeBy: sum

	column amount_of_credit_cards
		dataType: int64
		formatString: #,##0
		sourceColumn: amount_of_credit_cards
		summarizeBy: average

	column credit_card_balance
		dataType: double
		formatString: #,##0.00
		sourceColumn: credit_card_balance
		summarizeBy: sum

	column bank_loans
		dataType: double
		formatString: #,##0.00
		sourceColumn: bank_loans
		summarizeBy: sum

	column bank_deposits
		dataType: double
		formatString: #,##0.00
		sourceColumn: bank_deposits
		summarizeBy: sum

	column checking_accounts
		dataType: double
		formatString: #,##0.00
		sourceColumn: checking_accounts
		summarizeBy: sum

	column saving_accounts
		dataType: double
		formatString: #,##0.00
		sourceColumn: saving_accounts
		summarizeBy: sum

	column foreign_currency_account
		dataType: double
		formatString: #,##0.00
		sourceColumn: foreign_currency_account
		summarizeBy: sum

	column business_lending
		dataType: double
		formatString: #,##0.00
		sourceColumn: business_lending
		summarizeBy: sum

	column properties_owned
		dataType: int64
		formatString: #,##0
		sourceColumn: properties_owned
		summarizeBy: average

	column risk_weighting
		dataType: int64
		formatString: #,##0
		sourceColumn: risk_weighting
		summarizeBy: average

	column banking_relationship
		dataType: string
		sourceColumn: banking_relationship
		summarizeBy: none

	column gender
		dataType: string
		sourceColumn: gender
		summarizeBy: none

	column investment_advisor
		dataType: string
		sourceColumn: investment_advisor
		summarizeBy: none

