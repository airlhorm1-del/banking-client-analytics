	partition banking_clients = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents("C:\Users\user\OneDrive\Desktop\banking-client-analytics\clean\banking_data_powerbi.csv"),[Delimiter=",", Columns=30, Encoding=65001, QuoteStyle=QuoteStyle.None]),
